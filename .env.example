# Bunny Storage — Native HTTP API (NOT S3)
# Find zone password in Bunny dashboard -> Storage -> FTP & API Access tab (AccessKey = storage zone password)
# See https://bunny.net/docs/storage/http and websites/.repos.json deploy.storageZoneName
# Docs in websites/scripts/bunny/skills/

# Required — Storage zone (same as .repos.json deploy.storageZoneName)
BUNNY_STORAGE_ZONE=delux-temp
BUNNY_STORAGE_PASSWORD=<bunny-storage-zone-password>
# Endpoint depends on zone region: storage.bunnycdn.com (Falkenstein default), la.storage.bunnycdn.com, sg.storage.bunnycdn.com, syd.storage.bunnycdn.com
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com

# Per-site CDN Pull Zone (one per site, from Bunny dashboard -> CDN -> Pull Zones -> ID)
BUNNY_PULL_ZONE_ID=TODO-pullzone-deluxelimousine
# Shared account-level CDN API key — SAME value for all sites (from Bunny dashboard -> Account -> API)
# Prefer setting once in shell env or websites/.env (root), not duplicated per site.
# BUNNY_API_KEY=<shared-bunny-api-key>

# Legacy S3-compatible vars still supported via fallback (auto-mapped) for hilo:
# AWS_ACCESS_KEY_ID=$BUNNY_STORAGE_ZONE
# AWS_SECRET_ACCESS_KEY=$BUNNY_STORAGE_PASSWORD
# S3_BUCKET=$BUNNY_STORAGE_ZONE
