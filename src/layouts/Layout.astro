---
import Header from '../components/Astro/Header.astro';
import Footer from '../components/Astro/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  city?: string;
  service?: string;
}

const {
  title = "Limousine Service Anaheim & Orange County | Deluxe Limousine Service",
  description = "Looking for the best Limousine Service Anaheim? Deluxe Limousine Service offers a luxury fleet, pro chauffeurs & affordable rates. Call now for a free quote.",
  image = "https://deluxelimousineservice.com/wp-content/uploads/2022/09/Deluxe-Limousine-Service-adds-hummer-1-3-1.png",
  url = "https://deluxelimousineservice.com",
  city = "",
  service = ""
} = Astro.props;

// Programmatic Schema Markup for local SEO
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LimousineService",
  "name": "Deluxe Limousine Service",
  "image": image,
  "@id": "https://deluxelimousineservice.com/#website",
  "url": "https://deluxelimousineservice.com",
  "telephone": "714-313-9173",
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Anaheim Area",
    "addressLocality": city || "Anaheim",
    "addressRegion": "CA",
    "postalCode": "92801",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 33.8366,
    "longitude": -117.9143
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "sameAs": [
    "https://www.facebook.com/people/Deluxe-Limousine-Service/100063544521749/",
    "https://www.yelp.com/biz/deluxe-limousine-service-anaheim"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Montserrat:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-60LYY8SLJY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-60LYY8SLJY');
    </script>
  </head>
  <body>
    <!-- Header Navigation (ticker + top bar + nav) -->
    <Header />

    <!-- Main Content Slot -->
    <main>
      <slot />
    </main>

    <!-- MAP -->
    <section class="w-full">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3315.283047340742!2d-117.9904754!3d33.805008!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80dd2928ea3c3fdb%3A0xded2b51a21205ae5!2sDeluxe%20Limousine%20Service!5e0!3m2!1sen!2sin!4v1787771482107!5m2!1sen!2sin"
        width="600"
        height="450"
        style="border:0;"
        class="w-full h-[450px]"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </section>

    <!-- Footer -->
    <Footer />
  </body>
</html>

