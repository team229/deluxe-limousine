---
import { NAV_LINK, MOBILE_LINK } from '../../styles/utils';
const tickerItems = [
  'Lock In Your Free Hour!',
  'Chilled Sodas & Refreshments',
  'VIP Red Carpet Service',
  'Custom Birthday Decorations',
];

const fleetLinks = [
  { href: '/limo-service-orange-county/', label: 'Chrysler 300 Limousine' },
  { href: '/hummer-limo-service/', label: 'Hummer Stretch Limousine' },
  { href: '/black-car-service/', label: 'Executive SUV' },
  { href: '/sprinter-limo/', label: 'Mercedes Sprinter' },
  { href: '/party-bus-rental/', label: 'Party Bus' },
];

const serviceLinks = [
  { href: '/wedding/', label: 'Weddings' },
  { href: '/quinceanera/', label: 'Quinceanera' },
  { href: '/prom/', label: 'Prom' },
  { href: '/corporates/', label: 'Corporate Events' },
  { href: '/bachelor/', label: 'Bachelor Party' },
  { href: '/concerts/', label: 'Concerts & Sports' },
  { href: '/parties/', label: 'Parties' },
  { href: '/birthdays/', label: 'Birthdays' },
  { href: '/airport-rides/', label: 'Airport Rides' },
];

const navLinks = [
  { href: '/cities/', label: 'Cities' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about-us/', label: 'About' },
  { href: '/contact-us/', label: 'Contact Us' },
].map((link) => ({ ...link, label: link.label.toUpperCase() }));
---

<header class="font-header sticky top-0 z-[99999] w-full">
  <!-- RUNNING OFFER TICKER -->
  <div class="overflow-hidden whitespace-nowrap py-2 bg-linear-to-r from-gold via-[#b8941f] to-gold">
    <div class="inline-flex animate-ticker">
      {[0, 1].map(() =>
        tickerItems.map((item) => (
          <span class="inline-flex items-center gap-2 px-10 text-[13px] font-bold tracking-[1.5px] uppercase text-[#050505] whitespace-nowrap">
            <span class="text-[10px]">&#10022;</span>
            {item}
          </span>
        ))
      )}
    </div>
  </div>

  <!-- TOP BAR -->
  <div class="bg-[#050505] border-b border-gold/15">
    <div class="mx-auto max-w-[1400px] px-5 md:px-[35px] py-2.5 flex justify-between items-center gap-5">
      <div class="flex items-center gap-4 flex-wrap">
        <a href="tel:7143139173" class="text-gold hover:text-gold-soft transition-colors duration-300 text-[13.5px] flex items-center gap-1.5">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
          (714) 313-9173
        </a>
        <span class="w-px h-3.5 bg-white/15"></span>
        <a href="mailto:DELUXELIMOS22@GMAIL.COM" class="text-gold hover:text-gold-soft transition-colors duration-300 text-[13.5px]">
          DELUXELIMOS22@GMAIL.COM
        </a>
      </div>
      <div class="hidden md:block text-white/60 text-xs tracking-[1.5px] font-medium">
        Premium Luxury Limousine Services
      </div>
    </div>
  </div>

  <!-- MAIN NAVIGATION HEADER -->
  <div
    id="luxHeader"
    data-scrolled-class="bg-black/95 backdrop-blur-xl shadow-[0_12px_40px_rgba(0,0,0,0.5)]"
    class="w-full bg-linear-135 from-[#0a0a0a]/99 via-[#101010]/99 to-[#050505]/99 border-b border-white/[0.06] transition-all duration-[400ms]"
  >
    <div class="mx-auto max-w-[1400px] px-5 md:px-[35px] py-2.5 md:py-4 flex items-center justify-between gap-6">
      <!-- BRAND LOGO -->
      <a href="/" class="block relative z-[1001] transition-transform duration-300 hover:scale-[1.02]" aria-label="Deluxe Limousine Home">
        <img
          src="/images/2022/09/Logo-3.png"
          alt="Deluxe Limousine Service Logo"
          class="w-[110px] md:w-[160px] h-auto block"
          width="3124"
          height="1846"
        />
      </a>

      <!-- DESKTOP NAVIGATION -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-9 uppercase" aria-label="Desktop Navigation">
        <a href="/" class={NAV_LINK}>Home</a>

        {[
          { label: 'Fleet'.toUpperCase(), links: fleetLinks },
          { label: 'Services'.toUpperCase(), links: serviceLinks },
        ].map((dropdown) => (
          <div class="relative group">
            <button
              class="text-white/90 group-hover:text-gold text-[15px] font-medium tracking-[0.03em] bg-transparent border-none cursor-pointer flex items-center gap-1.5 relative py-2 font-header transition-colors duration-300 after:content-[''] after:absolute after:left-1/2 after:bottom-0 after:-translate-x-1/2 after:w-0 after:h-0.5 after:rounded after:bg-gold after:transition-[width] after:duration-300 group-hover:after:w-full"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {dropdown.label}
              <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-[2.5] transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 translate-y-4 w-[260px] bg-[#0d0d0d] border border-gold/20 rounded-[14px] p-2.5 opacity-0 invisible shadow-[0_20px_50px_rgba(0,0,0,0.6)] transition-all duration-300 group-hover:opacity-100 group-hover:visible group-hover:translate-y-1.5">
              {dropdown.links.map((link) => (
                <a href={link.href} class="block text-white/85 hover:text-gold hover:translate-x-1 py-3 px-4 rounded-lg text-[14.5px] font-normal transition-all duration-200 no-underline">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))}

        {navLinks.map((link) => (
          <a href={link.href} class={NAV_LINK}>{link.label}</a>
        ))}
      </nav>

      <!-- ACTION BUTTONS -->
      <div class="hidden lg:flex items-center gap-3.5 uppercase">
        <a href="tel:7143139173" class="flex items-center gap-2 text-white hover:text-gold px-5 py-3 rounded-[10px] bg-white/[0.03] border border-white/10 hover:border-gold/40 text-[14.5px] font-medium transition-all duration-300">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
          Call Now
        </a>
        <a href="/#booking" class="text-black bg-gold px-[26px] py-3 rounded-[10px] font-bold text-[14.5px] tracking-[0.02em] border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] transition-all duration-300 hover:-translate-y-px hover:bg-gold-soft hover:border-gold-soft hover:shadow-[0_10px_30px_rgba(212,175,55,0.35)] whitespace-nowrap">
          Book a Ride
        </a>
      </div>

      <!-- MOBILE HAMBURGER -->
      <button
        id="luxMobileToggle"
        class="lg:hidden w-8 h-6 flex flex-col justify-between border-none bg-transparent cursor-pointer relative z-[2001]"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <span class="w-full h-[2.5px] bg-gold rounded transition-all duration-300"></span>
        <span class="lux-toggle-mid w-full h-[2.5px] bg-gold rounded transition-all duration-300"></span>
        <span class="w-full h-[2.5px] bg-gold rounded transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <!-- MOBILE NAVIGATION MENU -->
  <div
    id="luxMobileMenu"
    class="flex lg:hidden flex-col bg-ink-soft w-full max-h-[calc(100vh-70px)] overflow-y-auto px-6 pt-[30px] pb-[120px] border-t border-white/[0.05] absolute top-full left-0 shadow-[0_30px_60px_rgba(0,0,0,0.8)] opacity-0 -translate-y-2.5 transition-[opacity,transform] duration-300 pointer-events-none uppercase"
  >
    <a href="/" class={MOBILE_LINK}>Home</a>

    {[
      { label: 'Our Fleet', links: fleetLinks },
      { label: 'Services', links: serviceLinks },
    ].map((submenu) => (
      <div class="lux-mobile-submenu border-b border-white/[0.05]">
        <div
          class="lux-mobile-collapse-title text-white py-4 text-base font-medium cursor-pointer flex justify-between items-center"
          role="button"
          tabindex="0"
        >
          {submenu.label} <span class="text-gold font-normal text-lg transition-transform duration-300">+</span>
        </div>
        <div class="hidden bg-white/[0.02] px-4 pt-1 pb-4 rounded-lg">
          {submenu.links.map((link) => (
            <a href={link.href} class="block text-white/75 hover:text-gold py-2.5 text-[14.5px] no-underline transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    ))}

    {navLinks.map((link) => (
      <a href={link.href} class={MOBILE_LINK}>{link.label}</a>
    ))}

    <a href="tel:7143139173" class="text-gold flex items-center gap-2 py-4 border-b border-white/[0.05] text-base font-medium no-underline">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
      (714) 313-9173
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('luxMobileToggle');
  const menu = document.getElementById('luxMobileMenu');
  const midBar = toggle?.querySelector('.lux-toggle-mid');
  const bars = toggle?.querySelectorAll('span');

  const MENU_OPEN_CLASSES = ['opacity-100', 'translate-y-0', 'pointer-events-auto'];
  const MENU_CLOSED_CLASSES = ['opacity-0', '-translate-y-2.5', 'pointer-events-none'];

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (!menu) return;

    if (isOpen) {
      MENU_OPEN_CLASSES.forEach((c) => menu.classList.remove(c));
      MENU_CLOSED_CLASSES.forEach((c) => menu.classList.add(c));
      bars?.forEach((b) => b.classList.remove('translate-y-[11px]', 'rotate-45', 'opacity-0', '-translate-y-[10.5px]', '-rotate-45'));
    } else {
      MENU_CLOSED_CLASSES.forEach((c) => menu.classList.remove(c));
      MENU_OPEN_CLASSES.forEach((c) => menu.classList.add(c));
      bars?.[0]?.classList.add('translate-y-[11px]', 'rotate-45');
      midBar?.classList.add('opacity-0');
      bars?.[2]?.classList.add('-translate-y-[10.5px]', '-rotate-45');
    }
  });

  // Mobile collapsible submenus
  document.querySelectorAll('.lux-mobile-collapse-title').forEach((title) => {
    const toggleSubmenu = () => {
      const content = title.nextElementSibling as HTMLElement | null;
      const plus = title.querySelector('span');
      const isOpen = content && !content.classList.contains('hidden');
      if (!content) return;
      if (isOpen) {
        content.classList.add('hidden');
        plus?.classList.remove('rotate-45');
      } else {
        content.classList.remove('hidden');
        plus?.classList.add('rotate-45');
      }
    };
    title.addEventListener('click', toggleSubmenu);
    title.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') toggleSubmenu();
    });
  });

  // Sticky header scroll effect
  const headerEl = document.getElementById('luxHeader');
  const scrolledClasses = (headerEl?.getAttribute('data-scrolled-class') ?? '').split(' ').filter(Boolean);
  const onScroll = () => {
    if (!headerEl) return;
    if (window.scrollY > 40) headerEl.classList.add(...scrolledClasses);
    else headerEl.classList.remove(...scrolledClasses);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
