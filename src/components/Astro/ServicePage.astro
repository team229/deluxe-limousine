---
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../React/FaqAccordion.tsx';
import ReservationForm from '../React/ReservationForm';
import type { ServicePage } from '../../data/service-pages';

const CONTAINER = 'mx-auto w-full max-w-[1240px] px-5';

function linkify(text: string) {
  const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, href) =>
    `<a href="${href}" class="text-gold hover:text-gold-soft underline underline-offset-4 transition-colors">${label}</a>`
  );
}

const { page } = Astro.props;

interface Vehicle { name: string; tagline: string; image: string; link: string }
const vehicles: Vehicle[] = [
  { name: 'Black Chrysler', tagline: 'Our Select Choice For All Events', image: '/cbm-assets/deluxe-limousine/homepage/black-chrysler-stretch-limo-2.webp', link: '/limo-service-orange-county/' },
  { name: 'White Chrysler', tagline: 'Ideal for weddings and Parties', image: '/cbm-assets/deluxe-limousine/homepage/image-19-3.webp', link: '/limousine-service/' },
  { name: 'Executive SUV', tagline: 'Need A Ride To The Airport?', image: '/cbm-assets/deluxe-limousine/black-car-service.jpeg', link: '/black-car-service/' },
  { name: 'Hummer', tagline: 'An Alternative For Larger Events', image: '/cbm-assets/deluxe-limousine/hummer-limo.jpeg', link: '/hummer-limo-service/' },
  { name: 'Sprinter Van', tagline: 'Great For Corporate Events', image: '/cbm-assets/deluxe-limousine/homepage/luxury-sprinter-limo-6.webp', link: '/sprinter-limo/' },
  { name: 'Party Bus', tagline: 'The Party Begins When You Step In The Bus', image: '/cbm-assets/deluxe-limousine/homepage/party-bus-7.webp', link: '/party-bus-rental/' },
];

// Split heroTitle at heroWord to highlight the middle word in gold
const word = page.heroWord || '';
const idx = page.heroTitle.indexOf(word);
const before = idx > 0 ? page.heroTitle.slice(0, idx) : '';
const after = idx >= 0 ? page.heroTitle.slice(idx + word.length) : '';
const hasWord = idx >= 0 && word.length > 0;
const stats = page.stats ?? [];
const airports = page.airports ?? [];
---

<Layout title={page.heroTitle} description={page.heroIntro[0]?.slice(0, 155)} url={`https://deluxelimousineservice.com/${page.slug}/`} image={page.heroBg}>
  <!-- HERO -->
  <section class="relative min-h-[72vh] flex items-center justify-center overflow-hidden bg-black">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image:url('${page.heroBg}')`}></div>
    <div class="absolute inset-0 bg-linear-to-b from-black/60 via-black/50 to-black/70"></div>
    <div class={`${CONTAINER} relative z-10 text-center pt-36 pb-24`}>
      <div class="mb-5 text-[0.75rem] font-medium tracking-[0.1em] uppercase">
        <a href="/" class="text-gold hover:text-gold-soft no-underline">← Back to Services</a>
        <span class="text-white/40 mx-3">|</span>
        <span class="text-gold/80">{page.heroBreadcrumb}</span>
      </div>
      <h1 class="font-serif-display text-[clamp(2.2rem,5vw,3.6rem)] text-white leading-[1.15] max-w-[900px] mx-auto">
        {hasWord ? (
          <>{before && <span>{before}</span>}<span class="text-gold">{word}</span>{after && <span>{after}</span>}</>
        ) : (
          page.heroTitle
        )}
      </h1>
      {page.heroSubtitle && <p class="text-gold uppercase tracking-[0.25em] text-sm font-semibold mt-4">{page.heroSubtitle}</p>}
      <div class="w-24 h-px bg-gold mx-auto my-6"></div>
      {page.heroIntro.map((p) => <p class="text-white/85 max-w-[760px] mx-auto mt-5 leading-[1.8]" set:html={linkify(p)} />)}
      <div class="flex gap-4 justify-center flex-wrap mt-9">
        <a href="#quote" class="inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft">Get a Free Quote</a>
        <a href="#fleet" class="inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline border border-gold text-gold bg-transparent hover:bg-gold hover:text-black">View Our Fleet</a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  {stats.length > 0 && (
    <section class="relative z-10 -mt-4 py-6">
      <div class={`${CONTAINER} bg-ink-raised border-y border-gold/30 py-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center`}>
        {stats.map((s) => (
          <div>
            <div class="font-serif-display text-3xl md:text-4xl font-bold text-gold">{s.num}</div>
            <div class="text-white/70 text-xs uppercase tracking-[0.08em] mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- OUR FULL FLEET -->
  {!(page as any).hideFleet && (
  <section id="fleet" class="py-20 bg-ink">
    <div class={CONTAINER}>
      <div class="text-center mb-12">
        <span class="text-gold uppercase text-xs font-bold tracking-[0.2em]">Our Fleet</span>
        <h2 class="font-serif-display text-3xl md:text-4xl font-bold mt-2">{page.heading}</h2>
        {page.intro && <p class="text-white/65 mt-4 leading-relaxed max-w-[640px] mx-auto" set:html={linkify(page.intro)} />}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {vehicles.map((v) => (
          <a href={v.link} class="group flex flex-col items-center text-center no-underline">
            <div class="w-full rounded-xl overflow-hidden border border-line mb-5 transition-all duration-300 group-hover:border-gold">
              <img src={v.image} alt={v.name} loading="lazy" width="480" height="320" class="w-full h-[210px] object-cover block transition-transform duration-500 group-hover:scale-[1.05]" />
            </div>
            <h3 class="font-serif-display text-2xl text-white mb-2">{v.name}</h3>
            <p class="text-white/60 text-sm">{v.tagline}</p>
            <span class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-2.5 text-xs font-bold uppercase tracking-wide transition-all duration-300 cursor-pointer no-underline border border-gold text-gold bg-transparent mt-5 group-hover:bg-gold group-hover:text-black">Learn More</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- PROSE / ABOUT -->
  {page.proseTitle && (
    <section class="py-20 bg-ink-soft border-y border-line">
      <div class={`${CONTAINER} max-w-[900px]`}>
        <span class="text-gold uppercase text-xs font-bold tracking-[0.2em]">{page.proseSubheading ?? 'About This Service'}</span>
        <h2 class="font-serif-display text-3xl md:text-4xl font-bold mt-3">{page.proseTitle}</h2>
        {page.proseIntro?.map((p) => <p class="text-white/70 leading-[1.9] mt-5" set:html={linkify(p)} />)}
      </div>
    </section>
  )}

  <!-- SERVICES GRID -->
  {page.servicesHeading && page.services && (
    <section class="py-20 bg-ink">
      <div class={CONTAINER}>
        <div class="text-center mb-12">
          <span class="text-gold uppercase text-xs font-bold tracking-[0.2em]">Complete Service</span>
          <h2 class="font-serif-display text-3xl md:text-4xl font-bold mt-2">{page.servicesHeading}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {page.services.map((s) => (
            <div class="flex items-center gap-3 px-4 py-4 rounded-xl border border-line bg-ink-raised text-white/85 text-sm hover:border-gold/40 transition-colors">
              <span class="text-gold shrink-0">◆</span>
              <span>{s}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- HIGHLIGHT BANNER -->
  {page.highlight && (
    <section class="py-20 bg-ink-soft border-y border-line">
      <div class={`${CONTAINER} grid grid-cols-1 lg:grid-cols-2 gap-12 items-center`}>
        <div>
          <h2 class="font-serif-display text-3xl md:text-4xl font-bold">{page.highlight.title}</h2>
          <p class="text-white/70 leading-[1.85] mt-5" set:html={linkify(page.highlight.text)} />
          <a href="#quote" class="inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft mt-8">Book Now</a>
        </div>
        <img src={page.highlight.image} alt={page.highlight.title} loading="lazy" class="w-full rounded-xl border border-line" />
      </div>
    </section>
  )}

  <!-- FEATURES + AIRPORTS -->
  <section class="py-20 bg-ink">
    <div class={CONTAINER}>
      <div class="text-center mb-12">
        <span class="text-gold uppercase text-xs font-bold tracking-[0.2em]">Sprinter Limo Features</span>
        <h2 class="font-serif-display text-3xl md:text-4xl font-bold mt-2">Everything You Need to Know</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {page.columns.map((col) => (
          <div class="bg-ink-raised border border-line rounded-xl p-8">
            <h3 class="font-serif-display text-gold text-xl mb-5">{col.title}</h3>
            <ul class="space-y-3">
              {col.items.map((item) => (
                <li class="flex items-start gap-3 text-white/75 text-[0.95rem]">
                  <svg class="w-4 h-4 mt-1 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {airports.length > 0 && (
        <div class="mt-10">
          <h3 class="font-serif-display text-gold text-xl mb-4">Airports We Serve</h3>
          <div class="flex flex-wrap gap-4">
            {airports.map((a) => (
              <span class="px-6 py-3 rounded-lg border border-gold/30 bg-ink-raised text-white/85 font-semibold">{a}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-ink-soft" id="faq">
    <div class="mx-auto w-full max-w-[860px] px-5">
      <h2 class="font-serif-display text-3xl md:text-4xl font-bold text-center">Frequently Asked Questions</h2>
      <div class="mt-10">
        <FaqAccordion client:load items={page.faqs.map((f) => ({ question: f.q, answer: f.a }))} />
      </div>
    </div>
  </section>

  <!-- BOOKING -->
  <section class="py-20 bg-ink" id="quote">
    <div class={CONTAINER}>
      <div class="text-center mb-10">
        <span class="text-gold uppercase text-xs font-bold tracking-[0.2em]">Book Now</span>
        <h2 class="font-serif-display text-3xl md:text-4xl font-bold mt-2">Let's Connect</h2>
      </div>
      <div class="max-w-[560px] mx-auto bg-ink-raised border border-line rounded-xl p-6 md:p-8">
        <ReservationForm client:visible />
      </div>
    </div>
  </section>

  <!-- CTA -->
  {page.ctaTitle && (
    <section class="py-20 bg-ink-soft border-t border-line text-center">
      <div class={CONTAINER}>
        <h2 class="font-serif-display text-3xl md:text-4xl font-bold">{page.ctaTitle}</h2>
        {page.ctaText && <p class="text-white/70 max-w-[640px] mx-auto leading-[1.8] mt-5" set:html={linkify(page.ctaText)} />}
        <a href="tel:7143139173" class="inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft mt-8">Call (714) 313-9173</a>
      </div>
    </section>
  )}
</Layout>
