---
interface Props {
  heading?: string;
  video?: string;
  poster?: string;
}
const {
  heading = "Orange County's Top-Rated Limousine Service — Chauffeured Luxury for Every Occasion",
  video = '/cbm-assets/deluxe-limousine/homepage/home-hero-video.mp4',
  poster = '/cbm-assets/deluxe-limousine/homepage/home-hero-poster.png',
} = Astro.props;
---

<section class="relative min-h-[88vh] flex items-center overflow-hidden bg-black">
  <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="auto" poster={poster}>
    <source src={video} type="video/mp4" />
  </video>
  <script is:inline>
    (() => {
      const v = document.currentScript?.previousElementSibling;
      if (v && v.tagName === 'VIDEO') {
        v.muted = true;
        const p = v.play();
        if (p && p.catch) p.catch(() => {});
      }
    })();
  </script>
  <div class="absolute inset-0 bg-linear-to-b from-black/55 via-black/35 to-black/75"></div>
  <div class="container relative z-10 text-center py-16">
    <h1 class="font-serif-display text-white text-[clamp(1.9rem,4.5vw,3.4rem)] leading-[1.25] max-w-[900px] mx-auto mb-8 [text-shadow:0_2px_20px_rgba(0,0,0,0.6)]">
      {heading}
    </h1>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft hover:border-gold-soft">Book Now</a>
      <a href="tel:7143139173" class="inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline border border-gold text-gold bg-transparent hover:bg-gold hover:text-black">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (714) 313-9173
      </a>
    </div>
  </div>
</section>
