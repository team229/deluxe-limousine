---
interface Occasion {
  title: string;
  image: string;
  link: string;
}
const occasions: Occasion[] = [
  { title: 'Weddings', image: '/cbm-assets/deluxe-limousine/homepage/occasions-weddings.jpeg', link: '/wedding/' },
  { title: 'Quinceañera', image: '/cbm-assets/deluxe-limousine/homepage/occasions-quinceanera.jpeg', link: '/quinceanera/' },
  { title: 'Prom', image: '/cbm-assets/deluxe-limousine/homepage/occasions-prom.jpeg', link: '/prom/' },
  { title: 'Corporate Events', image: '/cbm-assets/deluxe-limousine/homepage/occasions-corporate-events.jpeg', link: '/corporates/' },
  { title: 'Bachelor & Bachelorette', image: '/cbm-assets/deluxe-limousine/homepage/occasions-bachelor-bachelorette.jpeg', link: '/bachelor/' },
  { title: 'Concerts, Sports & Airport', image: '/cbm-assets/deluxe-limousine/homepage/occasions-concerts-sports-airport.jpeg', link: '/concerts/' },
];
const heading = Astro.props.heading ?? 'Limousine Rental For Every Special Occasion';
---

<section class="py-20">
  <div class="mx-auto w-full max-w-[1240px] px-5">
    <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white text-center">{heading}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {occasions.map((o) => (
        <a href={o.link} class="group relative block rounded-xl overflow-hidden border border-line transition-all duration-300 hover:-translate-y-1.5 hover:border-gold">
          <img src={o.image} alt={o.title} loading="lazy" width="480" height="600" class="w-full h-[340px] object-cover block transition-transform duration-500 group-hover:scale-[1.06]" />
          <div class="absolute inset-0 flex flex-col items-center justify-end pb-7 bg-linear-to-b from-transparent from-45% to-black/85">
            <h3 class="font-serif-display text-white text-xl m-0 mb-3 text-center">{o.title}</h3>
            <span class="text-gold text-[0.85rem] tracking-[0.08em] uppercase border-b border-gold pb-0.5">Book Now</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
