---
import { citiesList } from '../../../data/cities';
---

<section class="py-16 bg-ink-soft">
  <div class="mx-auto w-full max-w-[1240px] px-5 text-center">
    <h2 class="font-serif-display text-2xl md:text-3xl font-bold text-white">
      We serve <span class="text-gold">{citiesList.length}+ cities</span>
    </h2>
    <p class="text-white/60 mt-3">From Anaheim to Newport Beach — luxury coverage across Southern California.</p>
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      {citiesList.map((city) => (
        <a
          href={`/${city.slug}/`}
          class="px-4 py-2 rounded-full border border-line bg-ink-raised text-white/75 text-sm hover:border-gold hover:text-gold transition-colors duration-300 no-underline"
        >
          {city.name}
        </a>
      ))}
    </div>
  </div>
</section>
