---
---

<section class="py-10 bg-linear-to-r from-gold via-[#b8941f] to-gold">
  <div class="mx-auto w-full max-w-[1240px] px-5 flex items-center justify-between gap-6 flex-wrap">
    <div>
      <h2 class="text-black text-xl md:text-2xl font-bold font-serif-display">Lock in your free hour</h2>
      <p class="text-black/80 text-sm mt-1">Book 4+ hours and get your 1st hour completely free.</p>
    </div>
    <form id="freeHourBannerForm" class="flex items-center gap-3 flex-wrap">
      <input
        type="email"
        name="email"
        required
        placeholder="Enter Your Email Address"
        class="px-5 py-3 rounded-lg border-2 border-black/15 bg-black/10 text-black placeholder:text-black/50 text-sm focus:outline-none focus:border-black min-w-[260px]"
      />
      <button type="submit" class="px-6 py-3 rounded-lg bg-black text-gold text-sm font-bold hover:bg-black/90 transition-colors cursor-pointer">
        Claim Free Hour
      </button>
    </form>
  </div>
</section>

<script>
  const fb = document.getElementById('freeHourBannerForm');
  fb?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = fb.querySelector('input[type="email"]');
    const btn = fb.querySelector('button');
    const email = input?.value?.trim() || '';
    try {
      await fetch('https://api-inform.bythub.in/?formId=uaavNvBcBBznC581zb54', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: 'Website Visitor', email, message: 'Claim free hour offer' }),
      });
    } catch (_) {}
    if (btn) btn.textContent = '✓ Claimed';
  });
</script>
