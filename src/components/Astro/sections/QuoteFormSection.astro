---
import ReservationForm from '../../React/ReservationForm';
---

<section class="py-20 bg-ink-soft" id="quote-form">
  <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
    <div>
      <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white">
        Tell us the occasion. We'll handle the rest.
      </h2>
      <p class="text-white/70 leading-relaxed mt-4">
        Share your date, pickup location, and event details — our team responds within minutes with transparent,
        all-inclusive pricing. No hidden fees, no surprises.
      </p>
      <div class="mt-8 bg-linear-to-br from-gold/15 to-transparent border border-gold/30 rounded-xl p-6">
        <h3 class="font-serif-display text-xl text-gold font-bold">Lock In Your FREE HOUR!</h3>
        <p class="text-white/75 text-sm leading-relaxed mt-2">
          Book any fleet option for 4+ hours and get your 1st hour completely free. Ask about it when you call —
          we'll build the package around your event.
        </p>
        <a href="tel:7143139173" class="inline-flex items-center gap-2 text-gold font-semibold mt-4 hover:text-gold-soft transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
          (714) 313-9173
        </a>
      </div>
    </div>
    <div class="bg-ink-raised border border-line rounded-xl p-6 md:p-8">
      <ReservationForm client:visible />
    </div>
  </div>
</section>
