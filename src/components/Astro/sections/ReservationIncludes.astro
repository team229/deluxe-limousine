---
import ReservationForm from '../../React/ReservationForm';

const includes = [
  { title: 'First Hour on Us*', desc: 'Special introductory offer for featured packages (5 hours or more)' },
  { title: 'Chilled Sodas & Refreshments', desc: 'Fully stocked and complimentary' },
  { title: 'VIP Red Carpet Service', desc: 'Make a truly spectacular entrance' },
  { title: 'Custom Birthday Decorations', desc: 'Free setup to match your celebration style' },
];
---

<section class="py-20 bg-ink">
  <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 lg:grid-cols-2 gap-14 items-start">
    <div>
      <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white uppercase">
        Luxury Limousine Experiences Across <span class="text-gold normal-case">Orange County</span>
      </h2>
      <p class="text-white/70 leading-relaxed mt-4">
        Discover top-tier luxury limousine service across Orange County. Whether it's an elegant wedding or a seamless
        corporate arrival, we're dedicated to curating an extraordinary journey.
      </p>
      <h4 class="font-serif-display text-lg text-gold mt-8 mb-4">Every Deluxe Reservation Includes:</h4>
      <ul class="space-y-4">
        {includes.map((item) => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-white/80 text-sm leading-relaxed">
              <strong class="text-white">{item.title}</strong> – {item.desc}
            </span>
          </li>
        ))}
      </ul>
      <p class="text-white/50 text-sm italic mt-6">…plus many more custom options to create memories that last.</p>
    </div>

    <div class="bg-ink-raised border border-line rounded-xl p-6 md:p-8">
      <h3 class="font-serif-display text-xl text-white font-bold">Tell us the occasion. We'll handle the rest.</h3>
      <p class="text-white/60 text-sm mt-2">Request a free quote — our team responds within minutes.</p>
      <div class="mt-5">
        <ReservationForm client:visible />
      </div>
      <div class="mt-6 bg-linear-to-br from-gold/15 to-transparent border border-gold/30 rounded-lg p-4">
        <h4 class="font-serif-display text-base text-gold font-bold">Lock In Your FREE HOUR!</h4>
        <p class="text-white/70 text-xs leading-relaxed mt-1">
          Book any fleet option for 4+ hours and get your 1st hour completely free. Ask about it when you call.
        </p>
      </div>
    </div>
  </div>
</section>
