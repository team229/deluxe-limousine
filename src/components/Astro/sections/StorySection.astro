---
interface Props {
  heading?: string;
  paragraphs?: string[];
  image?: string;
}
const {
  heading = 'Our Story',
  paragraphs = [
    'Deluxe Limousine Service was established with one simple, yet powerful mission: to set a new standard of luxury, reliability, and professionalism in the ground transportation industry.',
    'Over the years, Deluxe has become the most trusted Anaheim Limo Service, building a name synonymous with punctuality, comfort, and five-star treatment on every ride.',
  ],
  image = '/cbm-assets/deluxe-limousine/homepage/deluxe-limousine-service-9.webp',
} = Astro.props;
---

<section class="py-20 bg-ink-soft">
  <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div>
      <img src={image} alt="Inside the Deluxe Limousine fleet" loading="lazy" width="800" height="533" class="w-full rounded-xl border border-line" />
    </div>
    <div>
      <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white">{heading}</h2>
      {paragraphs.map((p) => <p class="text-white/70 leading-[1.8] mt-4">{p}</p>)}
      <div class="flex gap-10 mt-7 flex-wrap">
        <div class="flex flex-col">
          <span class="font-serif-display text-3xl font-bold text-gold">16+</span>
          <span class="text-white/50 text-[0.82rem] tracking-[0.04em]">Years on the Road</span>
        </div>
        <div class="flex flex-col">
          <span class="font-serif-display text-3xl font-bold text-gold">30+</span>
          <span class="text-white/50 text-[0.82rem] tracking-[0.04em]">Cities Served</span>
        </div>
        <div class="flex flex-col">
          <span class="font-serif-display text-3xl font-bold text-gold">5.0</span>
          <span class="text-white/50 text-[0.82rem] tracking-[0.04em]">Google Rating</span>
        </div>
      </div>
    </div>
  </div>
</section>
