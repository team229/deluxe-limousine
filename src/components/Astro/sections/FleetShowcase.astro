---
interface Vehicle {
  name: string;
  desc: string;
  image: string;
  link: string;
}
interface Props {
  vehicles?: Vehicle[];
}
const vehicles: Vehicle[] = Astro.props.vehicles ?? [
  {
    name: 'Our Select Choice For All Events',
    desc: 'Black Chrysler Stretch Limousine',
    image: '/cbm-assets/deluxe-limousine/homepage/black-chrysler-stretch-limo-2.webp',
    link: '/limo-service-orange-county/',
  },
  {
    name: 'Ideal for weddings and Parties',
    desc: 'White Chrysler Stretch Limousine',
    image: '/cbm-assets/deluxe-limousine/homepage/image-19-3.webp',
    link: '/limo-service-orange-county/',
  },
  {
    name: 'Need A Ride To The Airport?',
    desc: 'Executive SUV Suburban',
    image: '/cbm-assets/deluxe-limousine/homepage/suv-suburban-4.webp',
    link: '/black-car-service/',
  },
  {
    name: 'An Alternative Preferred Limo',
    desc: 'Lincoln MKT Stretch Limousine',
    image: '/cbm-assets/deluxe-limousine/homepage/lincoln-mkt-stretch-limousine-5.webp',
    link: '/limo-service-orange-county/',
  },
  {
    name: 'Mercedes Sprinter For Corporate Events',
    desc: 'Luxury Mercedes Sprinter',
    image: '/cbm-assets/deluxe-limousine/homepage/luxury-sprinter-limo-6.webp',
    link: '/sprinter-limo/',
  },
  {
    name: 'The Party Begins When You Step In The Bus',
    desc: 'Party Bus',
    image: '/cbm-assets/deluxe-limousine/homepage/party-bus-7.webp',
    link: '/party-bus-rental/',
  },
];
---

<section class="py-20">
  <div class="mx-auto w-full max-w-[1240px] px-5">
    <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white text-center">
      Six ways to arrive.
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7 mt-10">
      {vehicles.map((v) => (
        <article class="flex flex-col bg-ink-raised border border-line rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-gold hover:shadow-[0_18px_40px_rgba(212,175,55,0.15)]">
          <div>
            <img src={v.image} alt={v.desc} loading="lazy" width="640" height="427" class="w-full h-[230px] object-cover block" />
          </div>
          <div class="p-6 flex flex-col gap-2 flex-1">
            <h3 class="font-serif-display text-white text-[1.05rem] m-0">{v.name}</h3>
            <p class="text-white/70 text-sm m-0 mb-3 flex-1">{v.desc}</p>
            <a href={v.link} class="self-start inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-xs font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft hover:border-gold-soft">
              Book Now
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
