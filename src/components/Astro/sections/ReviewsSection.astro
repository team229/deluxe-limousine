---
import ReviewsSlider from '../../React/ReviewsSlider.tsx';

const reviews = [
  {
    text: 'Excellent experience with Deluxe Limousine Service. Sal was professional, punctual, and made my daughters quinceanera unforgettable. The limo was spotless and stunning.',
    name: 'Maria G.',
    source: 'Google Review',
  },
  {
    text: 'I had a great experience with this limo service. Booking was easy and everything went smoothly. The chauffeur arrived early and the ride to LAX was smooth and luxurious.',
    name: 'Daniel K.',
    source: 'Google Review',
  },
  {
    text: 'Amazing experience! I needed this limo service for a bachelorette party with my girlfriends and it was perfect from start to finish. Highly recommend for any celebration.',
    name: 'Jessica R.',
    source: 'Google Review',
  },
  {
    text: 'Absolutely outstanding experience with this Orange County limousine service! Sal went above and beyond for our wedding day transportation. Five stars all the way.',
    name: 'Amanda T.',
    source: 'Google Review',
  },
  {
    text: "We used Deluxe Limousine Service for my daughter's birthday, and the experience was fantastic. The kids loved the lights and music. Will absolutely book again!",
    name: 'Robert M.',
    source: 'Google Review',
  },
  {
    text: "DELUXE service without the DELUXE prices. You can't beat that! Overall, had a great experience and will use them for all our special events.",
    name: 'Lisa P.',
    source: 'Google Review',
  },
];
---

<section class="py-20 bg-ink-soft">
  <div class="mx-auto w-full max-w-[1240px] px-5">
    <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white text-center">
      Unmatched luxury travel, endorsed and top-rated on Google
    </h2>
    <p class="mt-2 text-white/70 text-center">More from our clients</p>
    <div class="flex items-center justify-center gap-3 my-6">
      <span class="text-gold text-xl tracking-[0.15em]">★★★★★</span>
      <span class="text-white/70 text-[0.95rem]">5.0 on Google Reviews</span>
    </div>
    <ReviewsSlider client:load reviews={reviews} />
    <p class="text-white/60 text-sm leading-[1.8] max-w-[860px] mx-auto mt-10 text-center">
      Over the years, Deluxe has become the most trusted Anaheim Limo Service, building a name synonymous with
      punctuality, comfort, and five-star treatment on every single ride.
    </p>
  </div>
</section>
