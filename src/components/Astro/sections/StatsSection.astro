---
const stats = [
  { num: '16+', label: 'Years on the Road' },
  { num: '30+', label: 'Cities Served' },
  { num: '10K+', label: 'Rides Completed' },
  { num: '5.0', label: 'Google Rating' },
];
---

<section class="py-16 bg-linear-to-r from-gold/[0.08] to-transparent border-y border-gold/20">
  <div class="mx-auto w-full max-w-[1240px] px-5">
    <h2 class="font-serif-display text-2xl md:text-3xl font-bold text-white text-center">
      Sixteen years on the road.
    </h2>
    <p class="text-white/60 text-center mt-3 max-w-[640px] mx-auto">
      Proudly serving Orange County, Los Angeles County, and surrounding regions.
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">
      {stats.map((s) => (
        <div class="text-center">
          <span class="block font-serif-display text-4xl md:text-5xl font-bold text-gold">{s.num}</span>
          <span class="block text-white/60 text-xs tracking-[0.08em] uppercase mt-2">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
