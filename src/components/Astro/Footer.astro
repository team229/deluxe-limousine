---
---

<footer class="bg-ink border-t border-line font-sans-body">
  <!-- Main Footer Content -->
  <div class="mx-auto w-full max-w-[1240px] px-5 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
    <!-- Col 1: About & Trust -->
    <div>
      <a href="/" class="flex items-center gap-3 mb-4">
        <img src="/images/2022/09/Logo-3.png" alt="Deluxe Limousine Service" class="w-[140px] h-auto" width="3124" height="1846" />
      </a>
      <p class="text-white/60 text-sm leading-[1.7]">
        Deluxe Limousine Service provides premium luxury transportation. From elite executive travel to high-energy party bus rentals, we deliver punctuality, style, and unmatched professionalism.
      </p>
      <div class="flex items-center gap-2 mt-4">
        <span class="text-gold tracking-[0.15em]">★★★★★</span>
        <span class="text-white/60 text-xs">5.0 Google Rating</span>
      </div>
    </div>

    <!-- Col 2: Our Fleet -->
    <div>
      <h4 class="text-white font-semibold mb-5 text-[0.95rem] uppercase tracking-[0.08em]">Our Fleet</h4>
      <ul class="space-y-3">
        {[
          { href: '/limo-service-orange-county/', label: 'Chrysler 300 Limousine' },
          { href: '/hummer-limo-service/', label: 'Hummer Stretch Limousine' },
          { href: '/black-car-service/', label: 'Executive SUV Service' },
          { href: '/sprinter-limo/', label: 'Mercedes Sprinter Limo' },
          { href: '/party-bus-rental/', label: 'Party Bus Rental' },
        ].map((l) => (
          <li><a href={l.href} class="text-white/60 hover:text-gold text-sm transition-colors no-underline">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Col 3: Our Services -->
    <div>
      <h4 class="text-white font-semibold mb-5 text-[0.95rem] uppercase tracking-[0.08em]">Our Services</h4>
      <ul class="space-y-3">
        {[
          { href: '/wedding/', label: 'Wedding Limousine' },
          { href: '/quinceanera/', label: 'Quinceanera Limousine' },
          { href: '/prom/', label: 'Prom Limousine' },
          { href: '/airport-transportation-service/', label: 'Airport Transportation' },
        ].map((l) => (
          <li><a href={l.href} class="text-white/60 hover:text-gold text-sm transition-colors no-underline">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Col 4: Contact Info -->
    <div>
      <h4 class="text-white font-semibold mb-5 text-[0.95rem] uppercase tracking-[0.08em]">Contact Info</h4>
        <ul class="space-y-3">
          <li><a href="tel:7143139173" class="text-gold hover:text-gold-soft text-sm flex items-center gap-2 transition-colors no-underline">
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
            714-313-9173</a></li>
          <li><a href="mailto:DELUXELIMOS22@GMAIL.COM" class="text-white/60 hover:text-gold text-sm flex items-center gap-2 transition-colors no-underline">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            DELUXELIMOS22@GMAIL.COM</a></li>
          <li class="text-white/60 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            24/7 Dispatch Center</li>
          <li class="text-white/60 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Orange County Location</li>
          <li class="text-white/60 text-sm flex items-start gap-2">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <a href="https://maps.google.com/?q=8131+Electric+Ave,+Stanton,+CA+90680" target="_blank" rel="noopener" class="text-white/60 hover:text-gold transition-colors no-underline">8131 Electric Ave, Stanton, CA 90680</a></li>
        </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-line">
    <div class="mx-auto w-full max-w-[1240px] px-5 py-6 flex items-center justify-between gap-4 flex-wrap">
      <p class="text-white/50 text-xs m-0">© {new Date().getFullYear()} Deluxe Limousine Service. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/about-us/" class="text-white/50 hover:text-gold text-xs transition-colors no-underline">About</a>
        <a href="/contact-us/" class="text-white/50 hover:text-gold text-xs transition-colors no-underline">Contact</a>
        <a href="/privacy" class="text-white/50 hover:text-gold text-xs transition-colors no-underline">Privacy</a>
      </div>
    </div>
  </div>
</footer>
