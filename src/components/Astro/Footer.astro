---
---

<footer class="bg-ink border-t border-line font-sans-body">
  <!-- Newsletter Offer Banner -->
  <div class="py-12 bg-linear-135 from-gold/[0.12] to-transparent to-55% border-b border-gold/25">
    <div class="mx-auto w-full max-w-[1240px] px-5 flex items-center justify-between gap-6 flex-wrap">
      <div>
        <span class="inline-block px-3 py-1 rounded-full bg-gold/15 text-gold text-xs font-bold uppercase tracking-wide mb-3">Limited Time Offer</span>
        <h3 class="font-serif-display text-white text-2xl m-0">Lock In Your Free Hour!</h3>
        <p class="text-white/70 mt-2 max-w-[480px]">
          Book any fleet option for 4+ hours and get your 1st hour completely free. Plus chilled sodas & refreshments.
        </p>
      </div>
      <form id="freeHourForm" class="free-hour-form flex items-center gap-3 flex-wrap">
        <input type="email" name="email" required placeholder="Enter Your Email Address" class="px-5 py-3 rounded-lg bg-ink border border-line text-white placeholder:text-white/40 text-sm focus:outline-none focus:border-gold min-w-[260px]" />
        <button type="submit" class="px-6 py-3 rounded-lg bg-gold text-black text-sm font-bold hover:bg-gold-soft transition-colors cursor-pointer">Claim Free Hour</button>
      </form>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="mx-auto w-full max-w-[1240px] px-5 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
    <!-- Col 1: About & Trust -->
    <div>
      <a href="/" class="flex items-center gap-3 mb-4">
        <img src="/images/2022/09/Logo-3.png" alt="Deluxe Limousine Service" class="w-[140px] h-auto" width="3124" height="1846" />
      </a>
      <p class="text-white/60 text-sm leading-[1.7]">
        Serving Southern California with premier luxury transportation since 2008. Safe, punctual, and reliable travel, guaranteed.
      </p>
      <div class="flex items-center gap-2 mt-4">
        <span class="text-gold tracking-[0.15em]">★★★★★</span>
        <span class="text-white/60 text-xs">5.0 Google Rating</span>
      </div>
    </div>

    <!-- Col 2: Our Services -->
    <div>
      <h4 class="text-white font-semibold mb-5 text-[0.95rem] uppercase tracking-[0.08em]">Our Services</h4>
      <ul class="space-y-3">
        {[
          { href: '/limo-service-orange-county/', label: 'Chrysler 300 Limousine' },
          { href: '/hummer-limo-service/', label: 'Hummer Stretch Limousine' },
          { href: '/black-car-service/', label: 'Executive SUV Service' },
          { href: '/sprinter-limo/', label: 'Mercedes Sprinter Limo' },
          { href: '/party-bus-rental/', label: 'Party Bus Rental' },
        ].map((l) => (
          <li><a href={l.href} class="text-white/60 hover:text-gold text-sm transition-colors no-underline">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Col 3: Quick Links -->
    <div>
      <h4 class="text-white font-semibold mb-5 text-[0.95rem] uppercase tracking-[0.08em]">Quick Links</h4>
      <ul class="space-y-3">
        {[
          { href: '/wedding/', label: 'Wedding Limousine' },
          { href: '/quinceanera/', label: 'Quinceanera Limousine' },
          { href: '/prom/', label: 'Prom Limousine' },
          { href: '/airport-transportation-service/', label: 'Airport Transportation' },
          { href: '/gallery/', label: 'Gallery' },
          { href: '/contact-us/', label: 'Contact Us' },
        ].map((l) => (
          <li><a href={l.href} class="text-white/60 hover:text-gold text-sm transition-colors no-underline">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Col 4: Contact -->
    <div>
      <h4 class="text-white font-semibold mb-5 text-[0.95rem] uppercase tracking-[0.08em]">Contact Us</h4>
        <ul class="space-y-3">
          <li><a href="tel:7143139173" class="text-gold hover:text-gold-soft text-sm flex items-center gap-2 transition-colors no-underline">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
            (714) 313-9173</a></li>
          <li><a href="mailto:deluxelimos22@gmail.com" class="text-white/60 hover:text-gold text-sm flex items-center gap-2 transition-colors no-underline">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            deluxelimos22@gmail.com</a></li>
          <li class="text-white/60 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Anaheim, Orange County, CA</li>
          <li class="text-white/60 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            Open 24/7</li>
        </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-line">
    <div class="mx-auto w-full max-w-[1240px] px-5 py-6 flex items-center justify-between gap-4 flex-wrap">
      <p class="text-white/50 text-xs m-0">© {new Date().getFullYear()} Deluxe Limousine Service. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/about-us/" class="text-white/50 hover:text-gold text-xs transition-colors no-underline">About</a>
        <a href="/contact-us/" class="text-white/50 hover:text-gold text-xs transition-colors no-underline">Contact</a>
        <a href="/privacy" class="text-white/50 hover:text-gold text-xs transition-colors no-underline">Privacy</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const fh = document.getElementById('freeHourForm');
  fh?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = fh.querySelector('input[type="email"]');
    const btn = fh.querySelector('button');
    const email = input?.value?.trim() || '';
    try {
      await fetch('https://api-inform.bythub.in/?formId=uaavNvBcBBznC581zb54', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: 'Website Visitor', email, message: 'Claim free hour offer' }),
      });
    } catch (_) {}
    if (btn) btn.textContent = '✓ Claimed';
  });
</script>
