---
import FaqAccordion from '../React/FaqAccordion.tsx';
import ReservationForm from '../React/ReservationForm';
import FleetCards from './FleetCards.astro';

interface Card {
  title?: string;
  meta?: string;
  image?: string;
  items?: string[];
  text?: string;
}
interface ExtractButton {
  label: string;
  href: string;
}
interface ExtractSection {
  type?: string;
  bgImage?: string | null;
  bgVideo?: string | null;
  headings?: { level: string; text: string }[];
  paragraphs?: string[];
  lists?: { ordered: boolean; items: string[] }[];
  images?: { src: string; alt: string }[];
  buttons?: ExtractButton[];
  faqs?: { q: string; a: string }[];
  cards?: Card[];
}
interface Props {
  sections: ExtractSection[];
}
const { sections } = Astro.props;

const BTN_GOLD =
  'inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft hover:border-gold-soft';
const BTN_OUTLINE =
  'inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline border border-gold text-gold bg-transparent hover:bg-gold hover:text-black';
const HEADING = 'font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white';
const CONTAINER = 'mx-auto w-full max-w-[1240px] px-5';

function localize(href: string) {
  return href.replace('https://deluxelimousineservice.com', '');
}
function isTel(b: ExtractButton) {
  return b.href.startsWith('tel:') || b.href.startsWith('&tel:');
}
function btnClass(b: ExtractButton) {
  return isTel(b) ? BTN_OUTLINE : BTN_GOLD;
}
function btnHref(b: ExtractButton) {
  return isTel(b) ? 'tel:7143139173' : localize(b.href);
}

function fleetImage(src: string, idx: number): string {
  const fallback = [
    '/cbm-assets/deluxe-limousine/homepage/black-chrysler-stretch-limo-2.webp',
    '/cbm-assets/deluxe-limousine/homepage/black-chrysler-stretch-limo-2.webp',
    '/cbm-assets/deluxe-limousine/hummer-limo.jpeg',
    '/cbm-assets/deluxe-limousine/homepage/luxury-sprinter-limo-6.webp',
    '/cbm-assets/deluxe-limousine/homepage/party-bus-7.webp',
    '/cbm-assets/deluxe-limousine/black-car-service.jpeg',
  ];
  if (!src || src.includes('wp-content')) return fallback[idx] ?? fallback[0];
  return localize(src);
}

function headingText(headings: { level: string; text: string }[], center = false) {
  const node = headings.map((h) => h.text).join(' ');
  return node;
}

function linkify(text: string) {
  const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, href) =>
    `<a href="${href}" class="text-gold hover:text-gold-soft underline underline-offset-4 transition-colors">${label}</a>`
  );
}
---

{sections.map((sec, i) => {
  const type = sec.type || 'prose';
  const headings = sec.headings ?? [];
  const paragraphs = sec.paragraphs ?? [];
  const buttons = sec.buttons ?? [];
  const images = sec.images ?? [];
  const renderButtons = (center = false) =>
    buttons.length ? (
      <div class={`flex gap-4 mt-8 flex-wrap ${center ? 'justify-center' : ''}`}>
        {buttons.map((b) => (
          <a href={btnHref(b)} class={btnClass(b)}>{b.label}</a>
        ))}
      </div>
    ) : null;

  return (
    <>
      {type === 'hero' && (
        <section class="relative min-h-[68vh] flex items-center overflow-hidden bg-black">
          {sec.bgVideo ? (
            <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="auto" poster={sec.bgImage ?? ''}>
              <source src={sec.bgVideo} type="video/mp4" />
            </video>
          ) : sec.bgImage ? (
            <div class="absolute inset-0 bg-cover bg-center" style={`background-image:url('${sec.bgImage}')`}></div>
          ) : (
            <div class="absolute inset-0 bg-linear-to-br from-ink-raised to-black"></div>
          )}
          <div class="absolute inset-0 bg-linear-to-b from-black/70 via-black/50 to-black/80"></div>
          <div class={`${CONTAINER} relative z-10 text-center py-24`}>
            <span class="text-gold uppercase text-xs font-bold tracking-[0.2em] mb-4 block">Deluxe Limousine Service</span>
            {headings.map((h) =>
              h.level === 'H1' ? (
                <h1 class="font-serif-display text-[clamp(2rem,4.5vw,3.2rem)] text-white leading-[1.18] max-w-[860px] mx-auto">{h.text}</h1>
              ) : (
                <h2 class={HEADING + ' max-w-[760px] mx-auto'} set:html={h.text} />
              )
            )}
            {paragraphs.slice(0, 2).map((p) => <p class="text-white/75 max-w-[720px] mx-auto mt-5 leading-[1.75]" set:html={linkify(p)} />)}
            {renderButtons(true)}
          </div>
        </section>
      )}

      {type === 'stats' && (
        <section class="py-14 bg-ink-soft border-y border-gold/20">
          <div class={`${CONTAINER} grid grid-cols-2 md:grid-cols-4 gap-8`}>
            {(sec.cards ?? []).map((c) => {
              const raw = (c.title || c.text || '').trim();
              const m = raw.match(/^(\d+)([+★☆]?)(\s*)(.*)$/);
              const numVal = m ? parseInt(m[1], 10) : null;
              const symbol = m ? m[2] : '';
              const label = m ? m[4].trim() : '';
              const isStatic = raw.includes('/');
              const isCountable = numVal !== null && !isStatic;
              return (
                <div class="text-center">
                  {isCountable ? (
                    <span class="count-up block font-serif-display text-4xl font-bold text-gold" data-to={numVal} data-suffix={symbol}>0{symbol}</span>
                  ) : (
                    <span class="block font-serif-display text-4xl font-bold text-gold">{raw}</span>
                  )}
                  <span class="block text-white/60 text-xs uppercase tracking-[0.08em] mt-2">{isStatic ? '\u00a0' : (label || '\u00a0')}</span>
                </div>
              );
            })}
          </div>
        </section>
      )}

      {type === 'fleet' && (
        <FleetCards heading={headings[0]?.text || 'Our Full Fleet'} subheading={paragraphs[0] ?? ''} />
      )}

      {type === 'services' && (
        <section class="py-20 bg-ink-soft">
          <div class={CONTAINER}>
            {headings.slice(0, 1).map((h) => <h2 class={HEADING + ' text-center'} set:html={h.text} />)}
            <p class="text-white/60 text-center max-w-[640px] mx-auto mt-4" set:html={linkify(paragraphs[0])} />
            <div class="flex flex-wrap justify-center gap-4 mt-10">
              {(sec.cards ?? []).map((c) => (
                <a href="/contact-us/" class="flex items-center gap-2.5 px-5 py-3 rounded-full border border-gold/30 bg-ink-raised text-white/85 hover:border-gold hover:text-gold transition-all duration-300 no-underline">
                  <span>{c.title}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {type === 'occasions' && (
        <section class="py-20 bg-ink">
          <div class={CONTAINER}>
            {headings.slice(0, 1).map((h) => <h2 class={HEADING + ' text-center'} set:html={h.text} />)}
            {(() => {
              const labels = (sec.cards ?? []).map((c) => c.title);
              const headingLabels = headings.slice(1).map((h) => h.text);
              const rows = labels.length ? labels : headingLabels;
              return rows.length ? (
                <div class="flex flex-wrap justify-center gap-x-10 gap-y-5 mt-10">
                  {rows.map((label) => (
                    <span class="text-gold text-sm md:text-base font-semibold uppercase tracking-[0.08em] text-center">{label}</span>
                  ))}
                </div>
              ) : null;
            })()}
          </div>
        </section>
      )}

      {type === 'columns' && (
        <section class="py-20 bg-ink">
          <div class={CONTAINER}>
            {headings.map((h) => <h2 class={HEADING + ' text-center'} set:html={h.text} />)}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
              {(sec.cards ?? []).map((c) => (
                <div class="bg-ink-raised border border-line rounded-xl p-8">
                  <h3 class="font-serif-display text-gold text-xl mb-5">{c.title}</h3>
                  <ul class="space-y-3">
                    {(c.items ?? []).map((item) => (
                      <li class="flex items-start gap-3 text-white/75 text-[0.95rem]">
                        <svg class="w-4 h-4 mt-1 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {type === 'banner' && (
        <section class="relative py-24 overflow-hidden">
          {sec.bgImage && <div class="absolute inset-0 bg-cover bg-center" style={`background-image:url('${sec.bgImage}')`}></div>}
          <div class="absolute inset-0 bg-black/75"></div>
          <div class={`${CONTAINER} relative z-10 text-center`}>
            {headings.map((h) => <h2 class={HEADING + ' text-center'} set:html={h.text} />)}
            {paragraphs.map((p) => <p class="text-white/80 max-w-[700px] mx-auto mt-5 leading-[1.75]" set:html={linkify(p)} />)}
            {renderButtons(true)}
          </div>
        </section>
      )}

      {type === 'faq' && (
        <section class="py-20 bg-ink">
          <div class="mx-auto w-full max-w-[850px] px-5">
            {headings.map((h) => <h2 class={HEADING + ' text-center'} set:html={h.text} />)}
            <div class="mt-10">
              <FaqAccordion client:load items={(sec.faqs ?? []).map((f) => ({ question: f.q, answer: f.a.replace(/^\+\s*/, '') }))} />
            </div>
          </div>
        </section>
      )}

      {type === 'cta' && (
        <section class="py-20 bg-ink-soft border-t border-line">
          <div class={`${CONTAINER} text-center`}>
            {headings.map((h) => <h2 class={HEADING} set:html={h.text} />)}
            {paragraphs.map((p) => <p class="text-white/65 max-w-[640px] mx-auto mt-5 leading-[1.75]" set:html={linkify(p)} />)}
            {renderButtons(true)}
          </div>
        </section>
      )}

      {type === 'airports' && (
        <section class="py-20 bg-ink-soft">
          <div class={CONTAINER}>
            <h2 class={HEADING + ' text-center'} set:html={headingText(headings) || 'Airports We Serve'} />
            <div class="flex flex-wrap justify-center gap-4 mt-8">
              {(sec.cards ?? []).map((c) => (
                <span class="px-6 py-3 rounded-full border border-gold/30 bg-ink-raised text-white/85 text-sm font-semibold">{c.title || c.text}</span>
              ))}
            </div>
          </div>
        </section>
      )}

      {type === 'booking' && (
        <section class="py-20 bg-ink">
          <div class={`${CONTAINER} grid grid-cols-1 lg:grid-cols-2 gap-12 items-start`}>
            <div>
              {headings.map((h) => <h2 class={HEADING} set:html={h.text} />)}
              {paragraphs.map((p) => <p class="text-white/70 leading-[1.8] mt-4" set:html={linkify(p)} />)}
            </div>
            <div class="bg-ink-raised border border-line rounded-xl p-6 md:p-8">
              <ReservationForm client:visible />
            </div>
          </div>
        </section>
      )}

      {type === 'gallery' && (
        <section class="py-20 bg-ink">
          <div class={CONTAINER}>
            {headings.map((h) => <h2 class={HEADING + ' text-center'} set:html={h.text} />)}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
              {images.map((img) => (
                <figure class="m-0 rounded-xl overflow-hidden border border-line">
                  <img src={localize(img.src)} alt={img.alt} loading="lazy" class="w-full h-[240px] object-cover block" />
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      {type === 'prose' &&
        (() => {
          const h2 = headings.filter((h) => h.level === 'H2');
          const h3s = headings.filter((h) => h.level === 'H3');
          const isFleetProse = h2.length === 1 && h2[0].text.includes('Luxury Vehicles') && h3s.length >= 2;
          if (isFleetProse) {
            const intro = paragraphs[0] ?? '';
            const caps = paragraphs.slice(1);
            return (
              <section class="py-20 bg-ink">
                <div class={CONTAINER}>
                  <div class="text-center mb-12">
                    <span class="text-gold uppercase text-xs font-bold tracking-[0.2em]">Our Fleet</span>
                    <h2 class="font-serif-display text-3xl md:text-4xl font-bold mt-3">{h2[0].text}</h2>
                    {intro && <p class="text-white/60 max-w-[640px] mx-auto mt-4" set:html={linkify(intro)} />}
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    {h3s.map((h, idx) => {
                      const img = images[idx];
                      // 6 vehicles but only 5 caps in source (Black Chrysler has none); map accordingly
                      const isBlackChrysler = h.text.toLowerCase().includes('black chrysler');
                      const capIdx = caps.length < h3s.length && !isBlackChrysler && idx > 1 ? idx - 1 : idx;
                      const rawCap = isBlackChrysler ? '' : (caps[capIdx] ?? '');
                      const isCap = rawCap.startsWith('Up to');
                      return (
                        <div class="dlx-card group flex flex-col items-center text-center rounded-xl overflow-hidden">
                          <div class="dlx-imgwrap w-full overflow-hidden border border-line mb-5 transition-all duration-300 group-hover:border-gold group-hover:shadow-[0_18px_40px_rgba(212,175,55,0.12)]">
                            <img src={fleetImage(img?.src ?? '', idx)} alt={img?.alt || h.text} loading="lazy" width="480" height="320" class="w-full h-[220px] object-cover block" />
                          </div>
                          <h3 class="card-title font-serif-display text-xl text-white mb-1">{h.text}</h3>
                          {isCap && <p class="text-gold text-sm font-semibold">{rawCap}</p>}
                        </div>
                      );
                    })}
                  </div>
                </div>
              </section>
            );
          }
          return (
            <section class="py-16">
              <div class={`${CONTAINER} ${paragraphs.length <= 2 ? 'max-w-[860px]' : ''}`}>
                {headings.map((h) =>
                  h.level === 'H1' ? (
                    <h1 class="font-serif-display text-3xl md:text-4xl font-bold text-white mb-6">{h.text}</h1>
                  ) : (
                    <h2 class={HEADING + ' mb-5 mt-6 first:mt-0'}>{h.text}</h2>
                  )
                )}
                {paragraphs.map((p) => <p class="text-white/70 leading-[1.85] mb-5" set:html={linkify(p)} />)}
                {(sec.lists ?? []).map((l) => (
                  <ul class={`text-white/70 leading-[1.9] mb-5 ml-5 list-disc ${l.items.length > 8 ? 'columns-2 gap-10' : ''}`}>
                    {l.items.map((item) => <li>{item}</li>)}
                  </ul>
                ))}
                {renderButtons()}
              </div>
            </section>
          );
        })()}
    </>
  );
})}
