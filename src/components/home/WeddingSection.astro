---
const features = [
  "Stretch Limousines",
  "Wedding Limousines",
  "Church & Venue Transportation & Red Carpet Arrival",
  "Anaheim & Orange County",
  "16 Years of Experience",
];
---

<section class="relative overflow-hidden bg-black text-white">
  <div class="pointer-events-none absolute inset-0" style="background-image:repeating-linear-gradient(0deg,transparent,transparent 38px,rgba(255,255,255,0.02) 38px,rgba(255,255,255,0.02) 40px),repeating-linear-gradient(90deg,transparent,transparent 38px,rgba(255,255,255,0.02) 38px,rgba(255,255,255,0.02) 40px);"></div>

  <div class="relative z-[1] mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-16 px-6 py-20 lg:grid-cols-2">
    <div class="flex flex-col gap-6">
      <div class="inline-flex w-fit items-center gap-2.5 rounded border border-gold/40 bg-gold/[0.12] px-4 py-1.5">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="#d4af37" opacity="0.35"></path>
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="#d4af37" stroke-width="1.5" fill="none"></path>
        </svg>
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-gold">Wedding &amp; Special Event Transportation</span>
      </div>

      <h2 class="font-serif-display text-[36px] font-bold leading-[1.1] text-[#B19540] sm:text-[50px]">
        Your Wedding Day.<br /><span class="text-gold">Arrive in Timeless</span><br />Luxury.
      </h2>

      <p class="m-0 text-[19px] font-normal leading-[1.4] text-white">
        Make your wedding unforgettable from the very first moment. Deluxe Limousine Service provides elegant bridal transportation, wedding party shuttles, and luxury fleet packages across Anaheim and Orange County. From the ceremony to the reception and beyond — we coordinate every mile so you can focus on what matters most.
      </p>

      <div class="flex items-center gap-3">
        <span class="h-px flex-1 bg-gold/25"></span>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-[18px] w-[18px]" fill="#d4af37"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
        <span class="h-px flex-1 bg-gold/25"></span>
      </div>

      <div class="flex flex-wrap gap-2.5">
        {features.map((f) => (
          <span class="flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.06] px-3.5 py-1.5 text-[12.5px] font-semibold text-white/85">
            <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>{f}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="tel:7143139173" class="rounded-md bg-gold px-6 py-3.5 text-[14px] font-bold uppercase tracking-[0.06em] text-black transition-colors hover:bg-gold-soft">☎ Call (714) 313-9173</a>
        <a href="#deluxelimousineserviceForm" class="rounded-md border border-white/30 px-6 py-3.5 text-[14px] font-bold uppercase tracking-[0.06em] text-white transition-colors hover:border-gold hover:bg-gold hover:text-black">Get my Wedding Quote</a>
      </div>

      <p class="m-0 text-[13px] italic text-white/50">Limited availability on peak wedding dates — we recommend booking at least 3–6 months in advance to secure your preferred vehicle and time.</p>
    </div>

    <div class="relative">
      <div class="overflow-hidden rounded-2xl border border-white/10">
        <img src="/cbm-assets/deluxe-limousine/inline-images/inline-a8d337a7633d.png" alt="Deluxe Limousine Service luxury wedding fleet" loading="lazy" class="w-full object-cover" />
        <div class="absolute left-5 top-5 rounded bg-black/70 px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-gold">Wedding Ready</div>
      </div>

      <div class="mt-5 flex items-stretch gap-4">
        <div class="flex-1 rounded-xl border border-gold/20 bg-gradient-to-br from-gold/[0.06] to-white/[0.02] p-4">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full border border-gold/30 bg-gold/10">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
            </div>
            <div>
              <div class="font-serif-display text-[15px] font-bold text-white">Deluxe Limousine Service</div>
              <div class="text-[12px] text-white/50">Anaheim &amp; Orange County</div>
              <div class="mt-1 flex gap-0.5">
                {[0,1,2,3,4].map(() => (
                  <svg viewBox="0 0 12 12" class="h-3 w-3" fill="#d4af37"><path d="M6 1l1.4 2.8L10.5 4 8.3 6l.6 3.2L6 7.8 3.1 9.2 3.7 6 1.5 4l3.1-.2z"></path></svg>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="flex flex-1 flex-col justify-center rounded-xl border border-gold/20 bg-gradient-to-br from-gold/[0.06] to-white/[0.02] p-4 text-center">
          <span class="font-serif-display text-[32px] font-bold text-gold">24/7</span>
          <span class="text-[11px] uppercase tracking-[0.1em] text-white/60">Always Available</span>
        </div>
      </div>
    </div>
  </div>
</section>
