---
// Seasonal homepage section for New Year's Eve 2026/2027. Safe to remove after January.
---

<section class="relative overflow-hidden border-b border-gold/20 bg-gradient-to-br from-[#050b1a] via-[#0a1226] to-[#050915] text-white">
  <div class="pointer-events-none absolute -left-20 top-10 size-[24rem] rounded-full bg-gold/[0.07] blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-10 px-5 py-14 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14 lg:py-20">
    <div class="flex flex-col gap-5">
      <div class="flex items-center gap-3">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-gold">New Year's Eve 2026/2027</span>
        <span class="h-px flex-1 bg-gold/25" aria-hidden="true"></span>
      </div>

      <div class="relative w-fit" aria-hidden="true">
        <span class="font-serif-display text-[72px] font-bold leading-none text-gold/15 sm:text-[86px]">2027</span>
        <svg viewBox="0 0 24 24" class="absolute -right-3 -top-2 h-6 w-6 text-gold/80" fill="none" stroke="currentColor" stroke-width="1.3">
          <path d="M12 2v6M12 16v6M2 12h6M16 12h6M5 5l4 4M15 15l4 4M19 5l-4 4M9 15l-4 4" stroke-linecap="round" />
        </svg>
      </div>

      <h2 class="font-serif-display text-[34px] font-bold leading-[1.12] text-white sm:text-[44px]">
        Ring in 2027 with a <span class="text-gold italic">Safe Ride Home</span>
      </h2>
      <p class="m-0 text-[16px] leading-relaxed text-white/70">
        Dinner reservations, parties and countdown celebrations across Orange County and Los Angeles County — let a professional chauffeur handle the driving on New Year's Eve.
      </p>
      <p class="m-0 text-[16px] leading-relaxed text-white/70">
        Choose from our stretch limousines, Sprinters and party buses, available 24/7. Book in advance to secure your preferred vehicle and time for December 31.
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href="#deluxelimousineserviceForm" class="rounded-md bg-gold px-6 py-3.5 text-[13px] font-bold uppercase tracking-[0.06em] text-black transition-colors hover:bg-gold-soft">Request a Quote</a>
        <a href="/new-years-eve-limo-oc/" class="rounded-md border border-white/30 px-6 py-3.5 text-[13px] font-bold uppercase tracking-[0.06em] text-white transition-colors hover:border-gold hover:bg-gold hover:text-black">New Year's Eve Rides</a>
      </div>
    </div>

    <div class="relative -mx-5 sm:mx-0">
      <div class="relative aspect-video w-full overflow-hidden border-y border-gold/20 sm:rounded-2xl sm:border">
        <img
          src="/images/2026/10/new-years-eve-limo-orange-county-booking-timeline.webp"
          alt="Long black stretch limousine under warm street lights on wet pavement in Orange County on New Year's Eve"
          width="1600"
          height="900"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#050915]/75 via-transparent to-[#050915]/10" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse at 30% 35%,transparent 40%,rgba(5,9,21,0.5) 100%)" aria-hidden="true"></div>
        <div class="absolute right-4 top-4 flex items-center gap-2 rounded bg-black/75 px-3 py-1.5 backdrop-blur sm:right-5 sm:top-5">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-gold" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.2 2.2M16.9 16.9l2.2 2.2M19.1 4.9l-2.2 2.2M7.1 16.9l-2.2 2.2" stroke-linecap="round" />
            <circle cx="12" cy="12" r="4" />
          </svg>
          <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-gold sm:text-[11px]">December 31, 2026</span>
        </div>
      </div>
      <div class="absolute -bottom-3 left-4 hidden rounded border border-gold/30 bg-[#050b1a]/90 px-4 py-2 font-serif-display text-[13px] font-bold tracking-[0.12em] text-gold shadow-xl sm:block" aria-hidden="true">NEW YEAR'S EVE · OC &amp; LA</div>
    </div>
  </div>
</section>
