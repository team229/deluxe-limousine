---
// Seasonal event promos — remove or swap after Oct 31 (see Oktoberfest 301 note).
const promos = [
  {
    tag: "Homecoming Season",
    title: "Homecoming Limo Anaheim",
    text: "Safe, parent-approved rides for OC high schools. 1st hour FREE on 5+ hr packages.",
    img: "/images/2026/10/homecoming-limo-anaheim.webp",
    alt: "Homecoming limo rental Anaheim",
    href: "/homecoming-limo-anaheim/",
    cta: "Book Homecoming",
  },
  {
    tag: "Oct 30–31 · Selling Out",
    title: "Halloween Party Bus OC",
    text: "Multi-stop bar crawls, sober chauffeur, all-in pricing. Split across 15–30 passengers.",
    img: "/images/2026/10/halloween-party-bus-oc.webp",
    alt: "Halloween party bus Orange County",
    href: "/halloween-party-bus-oc/",
    cta: "Book Halloween",
  },
  {
    tag: "HB Weekends",
    title: "Oktoberfest Transport HB",
    text: "Hourly limos & party buses. Skip $40+ parking, ride together, scheduled return.",
    img: "/images/2026/10/oktoberfest-transport-huntington-beach.webp",
    alt: "Oktoberfest transportation Huntington Beach",
    href: "/oktoberfest-transport-huntington-beach/",
    cta: "Book Oktoberfest",
  },
];
---

<section class="border-b border-gold/20 bg-gradient-to-br from-[#141007] via-[#0d0d0d] to-[#141007] px-5 py-14">
  <div class="mx-auto max-w-[1200px]">
    <div class="mb-8 text-center">
      <span class="inline-block rounded-full border border-gold/40 bg-gold/10 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-gold">Fall Events · Now Booking</span>
      <h2 class="mt-4 font-serif-display text-3xl font-bold text-white sm:text-4xl">Ride to Every Fall Event in Style</h2>
      <p class="mx-auto mt-3 max-w-[640px] text-sm text-white/60">October weekends sell out — lock in your vehicle with all-in pricing and a call-now quote at <a href="tel:7143139173" class="text-gold underline underline-offset-4">(714) 313-9173</a>.</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {promos.map((p) => (
        <a href={p.href} class="group overflow-hidden rounded-xl border border-line bg-ink-raised transition-all duration-300 hover:-translate-y-1 hover:border-gold/60 hover:shadow-[0_16px_40px_rgba(0,0,0,0.5)]">
          <div class="relative h-44 overflow-hidden">
            <img src={p.img} alt={p.alt} loading="lazy" width="800" height="450" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <span class="absolute left-3 top-3 rounded-full bg-black/80 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-gold backdrop-blur">{p.tag}</span>
          </div>
          <div class="p-6">
            <h3 class="font-serif-display text-xl font-bold text-white transition-colors group-hover:text-gold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/65">{p.text}</p>
            <span class="mt-4 inline-block rounded-md border border-gold px-5 py-2.5 text-[12px] font-bold uppercase tracking-[0.1em] text-gold transition-colors group-hover:bg-gold group-hover:text-black">{p.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
