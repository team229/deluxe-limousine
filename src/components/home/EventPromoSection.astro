---
// Seasonal event promos — Holiday 2026 (New Year's Eve, holiday parties, Christmas lights).
// Swap contents again after Jan 1.
const promos = [
  {
    tag: "Dec 31 · Booking Fast",
    title: "New Year's Eve Limo OC",
    text: "Dinner, the countdown and a safe ride home. Sober chauffeur, red carpet, all-in pricing.",
    img: "/images/2026/10/new-years-eve-limo-orange-county-booking-timeline.webp",
    alt: "New Year's Eve limo rental in Orange County with fireworks over the skyline",
    href: "/new-years-eve-limo-oc/",
    cta: "Book New Year's",
  },
  {
    tag: "December · Weeknights Too",
    title: "Holiday Party Transportation",
    text: "Get the whole team there and home safe. Limos, Sprinters and party buses for 10–30 guests.",
    img: "/images/2026/10/services/bachelor-bachelorette.jpg",
    alt: "Holiday party transportation for corporate groups in Orange County",
    href: "/holiday-party-transportation/",
    cta: "Book Your Party",
  },
  {
    tag: "All December",
    title: "Christmas Lights Tour OC",
    text: "Cruise OC's best-lit neighborhoods with your holiday playlist on. Add the Newport Boat Parade.",
    img: "/images/2026/11/christmas-lights-tour-orange-county.webp",
    alt: "Christmas lights tour limousine in an Orange County neighborhood",
    href: "/christmas-lights-tour-oc/",
    cta: "Book Lights Tour",
  },
];
---

<section class="border-b border-gold/20 bg-gradient-to-br from-[#141007] via-[#0d0d0d] to-[#141007] px-5 py-14">
  <div class="mx-auto max-w-[1200px]">
    <div class="mb-8 text-center">
      <span class="inline-block rounded-full border border-gold/40 bg-gold/10 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-gold">Holiday Season · Now Booking</span>
      <h2 class="mt-4 font-serif-display text-3xl font-bold text-white sm:text-4xl">
        Ride Through the <span class="text-gold italic">Holidays</span> in Style
      </h2>
      <p class="mx-auto mt-3 max-w-[640px] text-sm text-white/60">
        December weekends and New Year's Eve sell out — lock in your vehicle with all-in pricing and a call-now quote at
        <a href="tel:7143139173" class="text-gold underline underline-offset-4">(714) 313-9173</a>.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {promos.map((p) => (
        <a href={p.href} class="group overflow-hidden rounded-xl border border-line bg-ink-raised transition-all duration-300 hover:-translate-y-1 hover:border-gold/60 hover:shadow-[0_16px_40px_rgba(0,0,0,0.5)]">
          <div class="relative h-44 overflow-hidden">
            <img src={p.img} alt={p.alt} loading="lazy" width="1600" height="900" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
            <span class="absolute left-3 top-3 rounded-full bg-black/80 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-gold backdrop-blur">{p.tag}</span>
          </div>
          <div class="p-6">
            <h3 class="font-serif-display text-xl font-bold text-white transition-colors group-hover:text-gold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/65">{p.text}</p>
            <span class="mt-4 inline-block rounded-md border border-gold px-5 py-2.5 text-[12px] font-bold uppercase tracking-[0.1em] text-gold transition-colors group-hover:bg-gold group-hover:text-black">{p.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
