---
const fleet = [
  { name: "Black Chrysler 300 Limo", cap: "UP TO 10", img: "/cbm-assets/deluxe-limousine/inline-images/inline-be707992c9c7.jpg", desc: "Our Select Choice For All Events", href: "/limo-service-orange-county/" },
  { name: "White Chrysler 300 Limo", cap: "UP TO 12", img: "/cbm-assets/deluxe-limousine/inline-images/inline-242d37c19555.jpg", desc: "Ideal for weddings and Parties", href: "/limousine-service/" },
  { name: "Executive SUV Service", cap: "UP TO 6", img: "/cbm-assets/deluxe-limousine/inline-images/inline-66abc4808baf.jpg", desc: "Need A Ride To The Airport?", href: "/black-car-service/" },
  { name: "Lincoln MKT Limo", cap: "UP TO 10", img: "/cbm-assets/deluxe-limousine/inline-images/inline-6b55fadc6404.jpg", desc: "An Alternative Preferred Limo", href: "/limousine-service/" },
  { name: "Mercedes Sprinter", cap: "UP TO 14", img: "/cbm-assets/deluxe-limousine/inline-images/inline-65576183c6b5.jpg", desc: "Mercedes Sprinter For Corporate Events", href: "/sprinter-limo/" },
  { name: "Party Bus", cap: "UP TO 20", img: "/cbm-assets/deluxe-limousine/inline-images/inline-0367dc25fbcf.jpg", desc: "The Party Begins When You Step In The Bus", href: "/party-bus-rental/" },
];
---

<section class="bg-black px-6 py-16">
  <div class="mx-auto max-w-[1400px] px-4">
    <div class="flex items-center justify-center gap-4">
      <span class="h-px w-[110px] max-w-[110px] bg-gold/50"></span>
      <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-gold">Our Limousine Fleet</span>
      <span class="h-px w-[110px] max-w-[110px] bg-gold/50"></span>
    </div>
    <h2 class="mt-4 text-center font-serif-display text-[36px] font-normal text-white sm:text-[44px]">Six ways to arrive.</h2>

    <div class="mx-auto mt-4 max-w-[760px] text-center">
      <h3 class="mb-3 font-sans-body text-[22px] font-bold text-white"><br />The Best Limousine Service in Anaheim</h3>
      <p class="m-0 text-[15px] leading-[1.6] text-white/70">
        Whether you need a limousine for a special event, a night out, or to visit one of your favorite attractions, we have the limo for you. Our spacious and luxurious limousines are fully air conditioned, cleaned and immaculately presented. Most noteworthy, we are fully licensed and bonded. We are waiting to make your special day an unforgettable experience, call us today.
      </p>
    </div>
  </div>

  <div class="mx-auto mt-12 grid max-w-[1400px] grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {fleet.map((c) => (
      <div class="flex flex-col text-center">
        <a href={c.href} class="dlx-card relative block overflow-hidden rounded-md">
          <img src={c.img} alt={c.name} loading="lazy" class="aspect-[350/200] w-full rounded-md object-cover" />
          <span class="absolute left-3 top-3 z-[2] rounded-[2px] border border-gold/30 bg-black/75 px-4 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-gold backdrop-blur-sm">{c.cap}</span>
        </a>
        <h3 class="mt-6 font-serif-display text-[26px] font-bold leading-tight text-white"><a href={c.href} class="no-underline hover:text-gold">{c.name}</a></h3>
        <div class="mx-auto mt-4 h-px w-full max-w-[340px] bg-gold/60"></div>
        <p class="mx-auto mt-4 max-w-[300px] text-[13px] leading-relaxed text-white/70">{c.desc}</p>
        <a href="tel:7143139173" class="mt-6 block w-full rounded-[2px] bg-gradient-to-r from-[#b8932e] via-[#d4af37] to-[#e8c87a] px-6 py-3.5 text-center text-[12px] font-bold uppercase tracking-[0.08em] text-black transition-all hover:brightness-110">
          Book Now
        </a>
      </div>
    ))}
  </div>
</section>
