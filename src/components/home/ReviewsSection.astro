---
// Vertical infinite review wall — matches screenshot: 3-column masonry, slow upward auto-scroll
type Review = { text: string; name: string; label: string; initial: string };

const col1: Review[] = [
  { text: "We booked transportation for homecoming in Brea and had a great experience. The limo was clean, the driver on time, and the kids had a great night.", name: "Tyler H.", label: "Homecoming · Brea", initial: "T" },
  { text: "We needed a car for a business meeting in Irvine and wanted something professional for our guests. Driver was on time and the service was exactly what we needed.", name: "Jennifer A.", label: "Business · Irvine", initial: "J" },
  { text: "We had family in town for a reunion in Buena Park and rented a limo so everyone could travel together. Great driver and a clean, comfortable ride.", name: "Karen M.", label: "Reunion · Buena Park", initial: "K" },
  { text: "Booked a limo for a concert in Anaheim with friends. Made the night so much easier — no parking, no traffic stress, just a great time.", name: "Brian C.", label: "Concert · Anaheim", initial: "B" },
  { text: "Our prom night was unforgettable. The Hummer limo was spotless and the chauffeur kept the vibe perfect the whole night.", name: "Marco T.", label: "Prom · Fullerton", initial: "M" },
  { text: "Used Deluxe for client airport transfers. Always on time, professional, and the black car was immaculate.", name: "Priya S.", label: "Corporate · Irvine", initial: "P" },
];

const col2: Review[] = [
  { text: "Got a limo for a girls night out in Garden Grove and it was so much fun. Everyone rode together and no one had to worry about driving. Booking was really easy.", name: "Natalie C.", label: "Girls Night · Garden Grove", initial: "N" },
  { text: "We took a limousine from Orange County to LA for a sports event. Great having the whole group together and no parking to deal with. The ride home was especially nice.", name: "Kevin M.", label: "Sports Event · OC - LA", initial: "K" },
  { text: "We rented a limousine for my son's graduation in Orange. It was decorated so nicely and the driver was wonderful with the kids.", name: "Angela D.", label: "Graduation · Orange", initial: "A" },
  { text: "Excellent experience with Deluxe Limousine Service. Sal was professional, punctual, and made the entire process easy from booking to drop-off.", name: "Eli Isho", label: "Verified Client", initial: "E" },
  { text: "We booked Deluxe for our wedding in Anaheim and had a really good experience. The limo was beautiful, our driver showed up early, and everything went smoothly.", name: "Emily R.", label: "Wedding · Anaheim", initial: "E" },
  { text: "Absolutely outstanding experience! Sal went above and beyond to make our ride smooth, professional, and luxurious from start to finish.", name: "Edward", label: "Verified Client", initial: "E" },
];

const col3: Review[] = [
  { text: "We used Deluxe for a bachelorette party in Laguna Beach. The limousine was perfect for our group and our driver was very friendly. Would use them again.", name: "Steven R.", label: "Bachelorette · Laguna Beach", initial: "S" },
  { text: "I booked a limousine for a proposal in Laguna Beach and everything went to plan. The driver was very accommodating and helped make the night really special.", name: "Lauren P.", label: "Proposal · Laguna Beach", initial: "L" },
  { text: "We booked a limousine for a school dance in Anaheim. The kids had a blast and the driver was very professional. Everything went smoothly.", name: "Diane S.", label: "School Dance · Anaheim", initial: "D" },
  { text: "Amazing experience! I needed this limo service for a bachelorette party with my girlfriends. The limo itself was luxurious and clean.", name: "Sena Ji", label: "Local Guide", initial: "S" },
  { text: "We used Deluxe for my daughter's birthday, and the experience was fantastic. Sal was easy to communicate with and made sure everything was taken care of.", name: "Majeda K.", label: "Birthday · Yorba Linda", initial: "M" },
  { text: "DELUXE service without the DELUXE prices. You can't beat that! Sal the driver was fantastic and very professional.", name: "Sabrina A.", label: "Verified Client", initial: "S" },
];
---

<section class="relative overflow-hidden border-t border-white/5 bg-black text-white">
  <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image:repeating-linear-gradient(0deg,transparent,transparent 38px,rgba(255,255,255,0.012) 38px,rgba(255,255,255,0.012) 40px),repeating-linear-gradient(90deg,transparent,transparent 38px,rgba(255,255,255,0.012) 38px,rgba(255,255,255,0.012) 40px);"></div>

  <div class="relative z-[1] mx-auto max-w-[1280px] px-5 py-14 sm:px-6 sm:py-20">
    <!-- Header — exact as screenshot -->
    <div class="mx-auto max-w-[760px] text-center">
      <p class="m-0 text-[11px] font-semibold uppercase tracking-[0.32em] text-[#c8a84a]">In their words</p>
      <h2 class="mt-3 font-serif-display text-[30px] font-normal leading-[1.15] text-white sm:text-[44px]">More from our clients</h2>
      <p class="mx-auto mt-3 max-w-[560px] text-[13px] leading-[1.6] text-white/45 sm:text-[13.5px]">Feedback shared with us directly by clients across Orange County</p>
    </div>

    <!-- Vertical marquee wall -->
    <div class="reviews-wall relative mt-10 h-[560px] overflow-hidden sm:mt-12 sm:h-[640px] lg:h-[680px]" style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 7%, black 92%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 7%, black 92%, transparent 100%);">
      <div class="grid h-full grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        <!-- Column 1 -->
        <div class="reviews-col overflow-hidden">
          <div class="reviews-track flex flex-col gap-4 lg:gap-5">
            {[...col1, ...col1].map((r) => (
              <article class="relative flex flex-col gap-3 rounded-[10px] border border-[rgba(212,175,55,0.13)] bg-[#0e0c09] px-5 py-5 sm:px-[22px] sm:py-[22px]">
                <div class="text-[11px] tracking-[0.18em] text-[#c8a84a]">★★★★★</div>
                <p class="m-0 text-[13.2px] leading-[1.65] text-white/80">{r.text}</p>
                <div class="mt-1 flex items-center gap-3 border-t border-white/[0.04] pt-4">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#E8C87A] to-[#C9973F] font-sans-body text-[13px] font-bold leading-none text-[#1a1300]">{r.initial}</div>
                  <div class="min-w-0">
                    <div class="text-[13px] font-semibold leading-none text-white">{r.name}</div>
                    <div class="mt-1 text-[10px] font-medium uppercase tracking-[0.09em] text-white/35">{r.label}</div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Column 2 — slightly offset timing for depth -->
        <div class="reviews-col hidden overflow-hidden md:block">
          <div class="reviews-track reviews-track--slow flex flex-col gap-4 lg:gap-5">
            {[...col2, ...col2].map((r) => (
              <article class="relative flex flex-col gap-3 rounded-[10px] border border-[rgba(212,175,55,0.13)] bg-[#0e0c09] px-5 py-5 sm:px-[22px] sm:py-[22px]">
                <div class="text-[11px] tracking-[0.18em] text-[#c8a84a]">★★★★★</div>
                <p class="m-0 text-[13.2px] leading-[1.65] text-white/80">{r.text}</p>
                <div class="mt-1 flex items-center gap-3 border-t border-white/[0.04] pt-4">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#E8C87A] to-[#C9973F] font-sans-body text-[13px] font-bold leading-none text-[#1a1300]">{r.initial}</div>
                  <div class="min-w-0">
                    <div class="text-[13px] font-semibold leading-none text-white">{r.name}</div>
                    <div class="mt-1 text-[10px] font-medium uppercase tracking-[0.09em] text-white/35">{r.label}</div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Column 3 -->
        <div class="reviews-col hidden overflow-hidden lg:block">
          <div class="reviews-track reviews-track--alt flex flex-col gap-4 lg:gap-5">
            {[...col3, ...col3].map((r) => (
              <article class="relative flex flex-col gap-3 rounded-[10px] border border-[rgba(212,175,55,0.13)] bg-[#0e0c09] px-5 py-5 sm:px-[22px] sm:py-[22px]">
                <div class="text-[11px] tracking-[0.18em] text-[#c8a84a]">★★★★★</div>
                <p class="m-0 text-[13.2px] leading-[1.65] text-white/80">{r.text}</p>
                <div class="mt-1 flex items-center gap-3 border-t border-white/[0.04] pt-4">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#E8C87A] to-[#C9973F] font-sans-body text-[13px] font-bold leading-none text-[#1a1300]">{r.initial}</div>
                  <div class="min-w-0">
                    <div class="text-[13px] font-semibold leading-none text-white">{r.name}</div>
                    <div class="mt-1 text-[10px] font-medium uppercase tracking-[0.09em] text-white/35">{r.label}</div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom fade for extra softness (fallback for browsers without mask) -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black to-transparent lg:h-28"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-black to-transparent"></div>
    </div>

    <div class="mt-6 flex justify-center">
      <a target="_blank" rel="noopener" href="https://www.google.com/search?q=Deluxe+Limousine+Service+Anaheim+reviews" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#c8a84a] transition-colors hover:text-[#e8c87a]">
        <span>View all Google Reviews</span>
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-none stroke-current stroke-[2] stroke-linecap-round stroke-linejoin-round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-track {
    animation: reviews-up 52s linear infinite;
    will-change: transform;
  }
  .reviews-track--slow {
    animation-duration: 64s;
    animation-delay: -8s;
  }
  .reviews-track--alt {
    animation-duration: 58s;
    animation-delay: -18s;
  }
  .reviews-wall:hover .reviews-track {
    animation-play-state: paused;
  }
  @keyframes reviews-up {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reviews-track { animation: none; }
  }
</style>
