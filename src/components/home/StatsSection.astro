---
// Isolated via iframe to guarantee 100% V5 fidelity (no Tailwind leakage)
---

<section class="w-full bg-black p-0 m-0">
  <iframe
    src="/stats-v5.html"
    title="Deluxe Limousine Stats - Sixteen years on the road"
    loading="lazy"
    style="width:100%;border:0;display:block;height:320px;overflow:hidden;background:#000"
    scrolling="no"
    onload="try{const d=this.contentDocument;const h=Math.max(d.documentElement.scrollHeight,d.body.scrollHeight);this.style.height=h+'px';}catch(e){}"
  ></iframe>
</section>
<script is:inline>
  // Auto-resize stats iframe
  const sFrame=document.currentScript?.previousElementSibling;
  // Actually find by src
  const f=document.querySelector('iframe[src="/stats-v5.html"]');
  if(f){
    f.addEventListener('load',()=>{
      try{
        const d=f.contentDocument;
        const setH=()=>{f.style.height=Math.max(d.documentElement.scrollHeight,d.body.scrollHeight)+'px'};
        setH();
        new MutationObserver(setH).observe(d.body,{childList:true,subtree:true});
        window.addEventListener('resize',setH);
      }catch(e){}
    });
    window.addEventListener('message',(e)=>{
      if(e.data?.type==='v5-resize' && e.data.height) f.style.height=e.data.height+'px';
    });
  }
</script>
