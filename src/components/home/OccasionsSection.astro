---
const occasions = [
  { title: "Weddings", img: "/cbm-assets/deluxe-limousine/inline-images/inline-5ff57ab779c5.jpg", href: "/wedding/" },
  { title: "Quinceañera", img: "/cbm-assets/deluxe-limousine/inline-images/inline-5c4209606f3e.jpg", href: "/quinceanera/" },
  { title: "Prom", img: "/cbm-assets/deluxe-limousine/inline-images/inline-ec2d26a6222d.jpg", href: "/prom/" },
  { title: "Corporate Events", img: "/cbm-assets/deluxe-limousine/inline-images/inline-653adf8abbac.jpg", href: "/corporates/" },
  { title: "Bachelor & Bachelorette", img: "/cbm-assets/deluxe-limousine/inline-images/inline-540e7c218866.jpg", href: "/bachelor/" },
  { title: "Concerts, Sports & Airport", img: "/cbm-assets/deluxe-limousine/inline-images/inline-146cfb3a3f73.jpg", href: "/concerts/" },
];
---

<section class="relative overflow-hidden border-t border-white/5 bg-black text-white">
  <div class="pointer-events-none absolute inset-0" style="background-image:repeating-linear-gradient(0deg,transparent,transparent 38px,rgba(255,255,255,0.01) 38px,rgba(255,255,255,0.01) 40px),repeating-linear-gradient(90deg,transparent,transparent 38px,rgba(255,255,255,0.01) 38px,rgba(255,255,255,0.01) 40px);"></div>

  <div class="relative z-[1] mx-auto flex max-w-[1200px] flex-col gap-12 px-6 py-20">
    <div class="mx-auto flex max-w-[800px] flex-col items-center gap-4 text-center">
      <div class="inline-flex items-center rounded border border-gold/40 bg-gold/[0.12] px-4 py-1.5">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-gold">Luxury Event Transportation</span>
      </div>
      <h2 class="m-0 font-serif-display text-[30px] font-bold leading-[1.3] text-white sm:text-[42px]">
        Limousine Rental<br /><span class="text-gold">For Every Special Occasion</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {occasions.map((o) => (
        <div class="group relative flex min-h-[360px] flex-col overflow-hidden rounded-[14px] border border-white/[0.08] transition-all hover:-translate-y-1.5 hover:border-gold/45 hover:shadow-[0_12px_28px_rgba(0,0,0,0.5)]">
          <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-[1.08]" style={`background-image:url(${o.img})`}></div>
          <div class="absolute inset-0 bg-gradient-to-b from-black/30 to-black/85 transition-colors group-hover:from-black/10 group-hover:to-black/90"></div>
          <div class="relative z-[3] flex flex-1 flex-col items-center justify-between gap-7 p-11">
            <div class="h-[1.5px] w-8 bg-gold/50 transition-all group-hover:w-14 group-hover:bg-gold"></div>
            <h3 class="m-0 text-center font-serif-display text-[22px] font-bold uppercase tracking-[0.02em] text-white text-shadow-[0_2px_4px_rgba(0,0,0,0.6)] transition-colors group-hover:text-gold">{o.title}</h3>
            <a href={o.href} class="inline-block w-full rounded-md border-[1.5px] border-white/30 px-6 py-3 text-center text-[12px] font-bold uppercase tracking-[0.12em] text-white transition-colors hover:border-gold hover:bg-gold hover:text-black">Book Now</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
