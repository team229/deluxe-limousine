---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="About Us | Deluxe Limousine Service Orange County" 
  description="Learn about Deluxe Limousine Service. Serving Southern California since 2008 with immaculate stretch limousines, professional chauffeurs, and 5-star service."
>
  <!-- Page Header -->
  <section class="py-24 border-b border-line bg-linear-to-b from-ink-raised to-ink">
    <div class="mx-auto w-full max-w-[1240px] px-5 text-center">
      <span class="text-gold uppercase text-xs font-bold tracking-[0.15em]">Our Story</span>
      <h1 class="font-serif-display text-4xl font-bold mt-2">Serving Southern California Since 2008</h1>
      <p class="text-white/60 max-w-[600px] mx-auto mt-4">A tradition of excellence, safety, and ultimate luxury on the road.</p>
    </div>
  </section>

  <!-- About Story Section -->
  <section class="py-20 bg-ink">
    <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-14 items-center">
      <div>
        <div class="rounded-xl overflow-hidden border border-line shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
          <img src="/images/2026/07/Whats-Driving-Orange-Countys-Shift-Toward-Limousine-Travel.webp" alt="Deluxe Limousine Fleet" class="w-full h-auto block" loading="lazy" />
        </div>
      </div>
      <div>
        <h2 class="font-serif-display text-3xl font-bold mb-5">The Deluxe Standard</h2>
        <p class="text-white text-[1.05rem] leading-[1.7] mb-6">Deluxe Limousine Service was founded with a single mission: to redefine chauffeured travel by combining meticulous vehicle detailing with career-certified professionalism.</p>
        <p class="text-white/70 leading-[1.8]">What started as a single stretch limousine has grown into a diverse fleet of late-model luxury stretch Hummers, executive SUVs, and Mercedes Sprinter passenger vans. Despite our growth, we remain a locally owned, customer-focused business. We do not broker our bookings out to third-party drivers. When you book a Deluxe ride, you get a Deluxe vehicle and a Deluxe chauffeur.</p>

        <h3 class="font-serif-display text-xl font-bold mt-8 mb-4">Our Core Values</h3>
        <ul class="space-y-5 list-none p-0">
          <li class="text-white/70 text-[0.9rem] relative pl-6">
            <span class="absolute left-0 top-0 text-gold">✦</span>
            <strong class="text-white block mb-1">Punctuality Above All:</strong> "Early is on time, on time is late." Our chauffeurs arrive 10-15 minutes prior to your scheduled pickup time.
          </li>
          <li class="text-white/70 text-[0.9rem] relative pl-6">
            <span class="absolute left-0 top-0 text-gold">✦</span>
            <strong class="text-white block mb-1">Immaculate Presentation:</strong> Every vehicle in our fleet is fully detailed, cleaned, and vacuumed before every reservation.
          </li>
          <li class="text-white/70 text-[0.9rem] relative pl-6">
            <span class="absolute left-0 top-0 text-gold">✦</span>
            <strong class="text-white block mb-1">Certified Professionals:</strong> All chauffeurs are fully licensed, background-checked, and trained in passenger safety and professional etiquette.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Stats Banner -->
  <section class="py-20 bg-ink-soft border-y border-line">
    <div class="mx-auto w-full max-w-[1240px] px-5 flex justify-around items-center flex-wrap gap-8 text-center">
      <div><h4 class="font-serif-display text-3xl text-gold mb-1">16+ Years</h4><p class="text-white/60 text-[0.85rem] uppercase tracking-[0.05em]">On the Road</p></div>
      <div><h4 class="font-serif-display text-3xl text-gold mb-1">11 Vehicles</h4><p class="text-white/60 text-[0.85rem] uppercase tracking-[0.05em]">In-House Fleet</p></div>
      <div><h4 class="font-serif-display text-3xl text-gold mb-1">2,740+</h4><p class="text-white/60 text-[0.85rem] uppercase tracking-[0.05em]">Clients Served</p></div>
      <div><h4 class="font-serif-display text-3xl text-gold mb-1">5.0 Stars</h4><p class="text-white/60 text-[0.85rem] uppercase tracking-[0.05em]">Average Rating</p></div>
    </div>
  </section>

  <!-- CTA Block -->
  <section class="py-20 bg-ink">
    <div class="mx-auto w-full max-w-[1240px] px-5 text-center">
      <h2 class="font-serif-display text-3xl font-bold">Ready to Plan Your Occasion?</h2>
      <p class="text-white/60 max-w-[600px] mx-auto mt-4">Whether you need an airport transfer to LAX, a wedding stretch limo, or a party bus for a night out, we are ready to assist you. Our dispatch office is open 24/7.</p>
      <div class="flex justify-center gap-5 flex-wrap mt-8">
        <a href="/contact-us" class="inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft hover:border-gold-soft">Request a Free Quote</a>
        <a href="tel:7143139173" class="inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline border border-gold text-gold bg-transparent hover:bg-gold hover:text-black">Call (714) 313-9173</a>
      </div>
    </div>
  </section>
</Layout>
