---
import Layout from '../layouts/Layout.astro';
import ReservationForm from '../components/React/ReservationForm';
---

<Layout 
  title="Contact Us | Deluxe Limousine Service Orange County" 
  description="Contact Deluxe Limousine Service. Request a quote or book your stretch limo or luxury Sprinter. Our 24/7 dispatch team is ready. Call (714) 313-9173."
>
  <!-- Page Header -->
  <section class="py-24 border-b border-line bg-linear-to-b from-ink-raised to-ink">
    <div class="mx-auto w-full max-w-[1240px] px-5 text-center">
      <span class="text-gold uppercase text-xs font-bold tracking-[0.15em]">Get In Touch</span>
      <h1 class="font-serif-display text-4xl font-bold mt-2">Contact Our Dispatch Center</h1>
      <p class="text-white/60 max-w-[600px] mx-auto mt-4">Available 24 hours a day, 7 days a week, 365 days a year.</p>
    </div>
  </section>

  <!-- Contact Split Section -->
  <section class="py-20 bg-ink">
    <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 lg:grid-cols-2 gap-14 items-start">
      <!-- Left side: Contact Details -->
      <div>
        <h2 class="font-serif-display text-3xl font-bold">We Are Ready to Serve You</h2>
        <p class="text-white/70 leading-[1.8]">Whether you have a last-minute flight shift, need to update your wedding timeline, or are ready to book a party bus, our dispatch team is standing by.</p>

        <div class="space-y-4 mt-8">
          <div class="flex items-start gap-4 p-6 rounded-xl border border-line bg-ink-raised">
            <div class="shrink-0 p-3 border border-gold rounded-full text-gold">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-semibold">Phone Number</h4>
              <p class="text-white/70 text-sm mt-1">Direct Call / Text: <a href="tel:7143139173" class="text-gold hover:text-gold-soft no-underline">(714) 313-9173</a></p>
              <p class="text-white/50 text-xs mt-1">Calls are routed to active dispatchers 24/7.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-6 rounded-xl border border-line bg-ink-raised">
            <div class="shrink-0 p-3 border border-gold rounded-full text-gold">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <h4 class="text-white font-semibold">Email Inquiries</h4>
              <p class="text-white/70 text-sm mt-1"><a href="mailto:deluxelimos22@gmail.com" class="text-gold hover:text-gold-soft no-underline">deluxelimos22@gmail.com</a></p>
              <p class="text-white/50 text-xs mt-1">We respond to email inquiries within the hour.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-6 rounded-xl border border-line bg-ink-raised">
            <div class="shrink-0 p-3 border border-gold rounded-full text-gold">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 0-10 10c0 5.25 10 12 10 12s10-6.75 10-12a10 10 0 0 0-10-10z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div>
              <h4 class="text-white font-semibold">Service Area</h4>
              <p class="text-white/70 text-sm mt-1">Anaheim Area, CA 92801</p>
              <p class="text-white/50 text-xs mt-1">Providing service throughout Orange, Los Angeles, and Riverside Counties.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right side: Reservation Form -->
      <div class="bg-ink-raised border border-line rounded-xl p-6 md:p-8">
        <ReservationForm client:load />
      </div>
    </div>
  </section>

  <!-- Interactive Map Section -->
  <section class="py-20 bg-ink-soft border-t border-line">
    <div class="mx-auto w-full max-w-[1240px] px-5">
      <div class="relative rounded-xl overflow-hidden border border-line h-[380px]">
        <iframe
          src="https://www.google.com/maps?q=Anaheim,CA&z=10&output=embed"
          class="w-full h-full border-0 grayscale opacity-60"
          loading="lazy"
          title="Deluxe Limousine Service coverage map"
        ></iframe>
        <div class="absolute inset-0 pointer-events-none"></div>
        <div class="absolute left-6 bottom-6 max-w-[340px] p-5 rounded-xl bg-ink-raised/95 backdrop-blur border border-gold/30">
          <h4 class="text-white font-semibold">Deluxe Limo Coverage</h4>
          <p class="text-white/70 text-xs mt-1">Our fleet operates out of Anaheim, serving Anaheim, Irvine, Newport Beach, Los Angeles (LAX), and Temecula wine valleys.</p>
          <a href="/cities" class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition-all duration-300 no-underline bg-gold text-black border border-gold hover:-translate-y-px hover:bg-gold-soft">See Cities Directory</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
