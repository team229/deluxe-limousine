---
import Layout from '../layouts/Layout.astro';
import ContentRenderer from '../components/Astro/ContentRenderer.astro';
import ReservationForm from '../components/React/ReservationForm';
import CtaBanner from '../components/Astro/sections/CtaBanner.astro';
import fs from 'node:fs';
import path from 'node:path';

type ExtractedPage = {
  path: string;
  title: string;
  description: string;
  ogImage: string | null;
  sections: any[];
};

export async function getStaticPaths() {
  const extractedDir = path.resolve(process.cwd(), 'src/data/extracted');
  // Slugs that have dedicated routes/pages and must NOT be served by the catch-all
  const RESERVED = new Set([
    '_index',      // homepage
    'blog',        // blog index
    'about-us',    // dedicated page
    'contact-us',  // dedicated page
    'gallery',     // dedicated gallery page (uses GalleryFilter, not extracted)
    '404-page',    // custom 404
    'oc',          // static landing page
    'oc__thank-you', // static thank-you page
  ]);
  const files = fs.readdirSync(extractedDir).filter((f) => f.endsWith('.json'));
  const paths = [];
  for (const file of files) {
    const base = file.replace(/\.json$/, '');
    if (RESERVED.has(base)) continue;
    // blog posts & category archives have dedicated routes
    if (base === 'blog' || base.startsWith('blog__')) continue;
    const data = JSON.parse(fs.readFileSync(path.join(extractedDir, file), 'utf8'));
    // skip pages with no content at all
    const blockCount = data.sections.reduce(
      (n: number, s: any) =>
        n + (s.headings?.length ?? 0) + (s.paragraphs?.length ?? 0) + (s.images?.length ?? 0) + (s.faqs?.length ?? 0),
      0
    );
    if (blockCount === 0) continue;
    const slug = base === '_index' ? undefined : base.split('__').join('/');
    paths.push({ params: { slug }, props: { page: data } });
  }
  return paths;
}

const { page } = Astro.props as { page: ExtractedPage };
const sections = page.sections ?? [];
const firstImage = sections.flatMap((s) => s.images).find((i) => i)?.src;
const cityMatch = page.path.match(/^\/([a-z-]+)\/$/);
const cityName = cityMatch ? cityMatch[1].replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : null;
---

<Layout title={page.title} description={page.description} url={`https://deluxelimousineservice.com${page.path}`} image={page.ogImage ?? undefined} city={cityName ?? ''}>
  {sections.length > 0 ? <ContentRenderer sections={sections} /> : <div class="mx-auto w-full max-w-[1240px] px-5 py-20" />}
  <section class="py-20 bg-ink-soft" id="quote">
    <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-serif-display text-2xl md:text-3xl font-bold leading-snug text-white">Get Your Free Quote Today</h2>
        <p class="text-white/70 leading-[1.85] mt-4">
          Tell us about your event and we'll respond within minutes with transparent, all-inclusive pricing.
          Professional chauffeurs, immaculate vehicles, and 24/7 availability — that's the Deluxe difference.
        </p>
        <p class="text-gold font-semibold mt-4">Call us directly: <a href="tel:7143139173" class="text-gold hover:text-gold-soft no-underline">(714) 313-9173</a></p>
      </div>
      <div class="bg-ink-raised border border-line rounded-xl p-6 md:p-8">
        <ReservationForm client:visible />
      </div>
    </div>
  </section>
  <CtaBanner />
</Layout>
