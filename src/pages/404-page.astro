---
import Layout from '../layouts/Layout.astro';

const title = '404 - Page Not Found | Deluxe Limousine Service';
const description =
  'The page you are looking for could not be found. Explore Deluxe Limousine Service — premier limousine service in Orange County, Anaheim and Southern California.';
---

<Layout title={title} description={description} url="https://deluxelimousineservice.com/404-page/">
  <section class="min-h-[70vh] flex items-center bg-ink py-20">
    <div class="mx-auto w-full max-w-[700px] px-5 text-center">
      <span class="block text-gold text-8xl md:text-9xl font-serif-display font-bold">404</span>
      <h1 class="font-serif-display text-2xl md:text-3xl text-white mt-4">Page Not Found</h1>
      <p class="text-white/70 leading-relaxed mt-4">
        The page you are looking for may have been moved or no longer exists. Let's get you back on the road to luxury.
      </p>
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline bg-gold text-black border border-gold shadow-[0_8px_25px_rgba(212,175,55,0.2)] hover:-translate-y-px hover:bg-gold-soft hover:border-gold-soft">
          Return Home
        </a>
        <a href="/contact-us/" class="inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer no-underline border border-gold text-gold bg-transparent hover:bg-gold hover:text-black">
          Contact Us
        </a>
      </div>
      <div class="mt-10">
        <a href="tel:7143139173" class="text-gold font-semibold hover:text-gold-soft transition-colors">☎ Call (714) 313-9173</a>
      </div>
    </div>
  </section>
</Layout>
