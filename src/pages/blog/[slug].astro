---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import FaqAccordion from '../../components/React/FaqAccordion.tsx';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const faqs = post.data.faqs ?? [];
---

<PostLayout frontmatter={post.data}>
  <Content />
  {faqs.length > 0 && (
    <div class="mt-12">
      <h2 class="text-white font-serif-display text-2xl mb-6">Frequently Asked Questions</h2>
      <FaqAccordion client:load items={faqs} />
    </div>
  )}
</PostLayout>
