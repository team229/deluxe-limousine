---
import { getCollection } from 'astro:content';
import path from 'node:path';
import fs from 'node:fs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = new Set<string>();
  posts.forEach((p) => categories.add(p.data.category ?? 'blog'));
  return [...categories].map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props as { category: string };
const posts = (await getCollection('blog'))
  .filter((p) => (p.data.category ?? 'blog') === category)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const label = category.charAt(0).toUpperCase() + category.slice(1);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{label} | Deluxe Limousine Service Blog</title>
    <meta name="description" content={`Browse ${label.toLowerCase()} articles from the Deluxe Limousine Service blog. Guides, news and tips for luxury limousine travel in Southern California.`} />
    <link rel="canonical" href={`https://deluxelimousineservice.com/blog/category/${category}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${label} | Deluxe Limousine Service Blog`} />
    <meta property="og:description" content={`Browse ${label.toLowerCase()} articles from the Deluxe Limousine Service blog.`} />
    <meta property="og:url" content={`https://deluxelimousineservice.com/blog/category/${category}/`} />
    <meta property="og:site_name" content="Deluxe Limousine Service" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${label} | Deluxe Limousine Service Blog`} />
    <meta name="twitter:description" content={`Browse ${label.toLowerCase()} articles from the Deluxe Limousine Service blog.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Montserrat:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-60LYY8SLJY"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-60LYY8SLJY');
    </script>
  </head>
  <body class="bg-ink text-white font-sans-body antialiased">
    <header class="py-14 border-b border-line bg-linear-to-b from-ink-raised to-ink text-center">
      <div class="mx-auto w-full max-w-[900px] px-5">
        <span class="text-gold uppercase text-xs font-bold tracking-[0.15em]">Category</span>
        <h1 class="font-serif-display text-3xl font-bold mt-2">{label}</h1>
        <p class="text-white/60 mt-3">Posts from the Deluxe Limousine Service {label.toLowerCase()} archive.</p>
      </div>
    </header>

    <main class="py-16">
      <div class="mx-auto w-full max-w-[1240px] px-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.length === 0 && <p class="text-white/60">No posts in this category yet.</p>}
        {posts.map((post) => {
          const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          return (
            <article class="bg-ink-raised border border-line rounded-xl overflow-hidden flex flex-col transition-colors duration-300 hover:border-gold">
              <div class="aspect-video bg-ink overflow-hidden">
                {post.data.featuredImage ? <img src={post.data.featuredImage} alt={post.data.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-[1.06]" /> : <div class="w-full h-full flex items-center justify-center"><span class="text-gold text-sm font-bold tracking-[0.1em]">DELUXE LIMO</span></div>}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <span class="text-gold text-xs font-semibold uppercase tracking-[0.05em] mb-2">{formattedDate}</span>
                <h3 class="font-serif-display text-lg leading-snug mb-3">
                  <a href={`/blog/${post.id}`} class="text-white hover:text-gold no-underline transition-colors">{post.data.title}</a>
                </h3>
                <p class="text-white/60 text-sm flex-1 line-clamp-3">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="text-gold text-sm font-semibold no-underline mt-4 inline-flex items-center gap-1 hover:gap-2 transition-all">Read Article →</a>
              </div>
            </article>
          );
        })}
      </div>
    </main>
  </body>
</html>
